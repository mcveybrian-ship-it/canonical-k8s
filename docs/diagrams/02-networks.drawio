<mxfile host="make-diagrams.py" agent="make-diagrams.py" version="24.0.0"><diagram id="2-networks" name="2 - Networks"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Networks - management, storage, and the gap" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="No gateway and no router on either enclave network. IPv6: link-local only today; dual-stack is required for the cluster (B-07) and router advertisements are ignored everywhere (3.55)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="160" as="geometry"/></mxCell><mxCell id="c5" value="built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c6" value="planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c7" value="lab only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c8" value="option" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c9" value="Generated by docs/diagrams/make-diagrams.py from enclave-addresses.env and vm-specs.env - re-run it, do not hand-edit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="182" width="250" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;OUTSIDE THE GAP&lt;/b&gt; - online side, not in the ATO boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#cc9999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#884444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1320" height="210" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;FortiGate FG-60F&lt;/b&gt;&lt;br&gt;internet edge · staging 10.2.10.0/24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;stage-01&lt;/b&gt;&lt;br&gt;10.2.10.160 (+ 10.2.20.160 in State A)&lt;br&gt;mirror · repo · builds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;build-01&lt;/b&gt;&lt;br&gt;10.2.10.124&lt;br&gt;transfer SSD · private backups" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Dell R7515&lt;/b&gt; - Hyper-V host (lab)&lt;br&gt;runs stage-01; RAID 10 on D:" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="520" height="160" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;lab-vault&lt;/b&gt; 10.2.30.170&lt;br&gt;LUKS2 /srv/cold · third copy (lab only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="190" width="290" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;gap cable #1&lt;/b&gt;&lt;br&gt;FortiGate dmz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="140" y="320" width="140" height="36" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;gap cable #2&lt;/b&gt;&lt;br&gt;Dell 10 Gb (lab only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1030" y="320" width="160" height="36" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;MANAGEMENT&lt;/b&gt; - TL-SG108S-M2, unmanaged · &lt;b&gt;10.2.20.0/24&lt;/b&gt; · no gateway, no DHCP in use, no IPv6 router" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="900" height="60" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;STORAGE&lt;/b&gt; - GigaPlus 2.5 G + SFP+, unmanaged · &lt;b&gt;10.2.30.0/24&lt;/b&gt; · no uplink, no gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="390" width="690" height="60" as="geometry"/></mxCell><mxCell id="c22" value="State A: cable in · State B: unplugged" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;host-1&lt;/b&gt;&lt;br&gt;br0 = 10.2.20.155 (onboard NIC)&lt;br&gt;storage NIC = 10.2.30.155  (planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="360" height="120" as="geometry"/></mxCell><mxCell id="c25" value="br0" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c24" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="2.5 G USB adapter" style="endArrow=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c24" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;host-2&lt;/b&gt;&lt;br&gt;br0 = 10.2.20.156 (onboard NIC)&lt;br&gt;storage NIC = 10.2.30.156  (planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="360" height="120" as="geometry"/></mxCell><mxCell id="c28" value="br0" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c27" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="2.5 G USB adapter" style="endArrow=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c27" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;host-3&lt;/b&gt;&lt;br&gt;br0 = 10.2.20.157 (onboard NIC)&lt;br&gt;storage NIC = 10.2.30.157  (planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="500" width="360" height="120" as="geometry"/></mxCell><mxCell id="c31" value="br0" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c30" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="2.5 G USB adapter" style="endArrow=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c30" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;host-4&lt;/b&gt;&lt;br&gt;br0 = 10.2.20.158 (onboard NIC)&lt;br&gt;storage NIC = 10.2.30.158  &lt;b&gt;(configured 2026-10-01)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="500" width="360" height="120" as="geometry"/></mxCell><mxCell id="c34" value="br0" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c33" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="2.5 G USB adapter" style="endArrow=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c33" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Management address plan&lt;/b&gt; (enclave-addresses.env)&lt;br&gt;hosts 10.2.20.155 - 10.2.20.158&lt;br&gt;svc-mgmt-01 10.2.20.161 · svc-repo-01 10.2.20.162 · svc-harbor-01 10.2.20.163 · svc-obs-01 10.2.20.164&lt;br&gt;pg-01..03 10.2.20.165 - 10.2.20.167&lt;br&gt;&lt;b&gt;Kubernetes API VIP 10.2.20.170&lt;/b&gt; (keepalived) · control planes 10.2.20.171 - 10.2.20.173 · workers 10.2.20.181 - 10.2.20.184&lt;br&gt;&lt;b&gt;LoadBalancer pool 10.2.20.200 - 10.2.20.250&lt;/b&gt; (built-in, layer-2) - the Gateway VIP and *.apps come from here&lt;br&gt;pods 10.1.0.0/16 · services 10.152.183.0/24 (Canonical defaults, set at bootstrap)&lt;br&gt;DNS: enclave.internal on svc-mgmt-01 · *.apps.enclave.internal → the Gateway VIP (today a placeholder on the API VIP)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1000" height="170" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Storage network&lt;/b&gt; (backlog 3.16)&lt;br&gt;hosts 10.2.30.155 - 10.2.30.158 (STORAGE_HOST_n) · lab: vault 10.2.30.170, NAS 10.2.30.171&lt;br&gt;&lt;b&gt;planned:&lt;/b&gt; br-storage on each host so worker VMs get a second NIC - Ceph's cluster (replication) network here, its public network on management&lt;br&gt;measured 2026-10-01: raw TCP host-4 → vault 274 MB/s (the 2.5 G link ~93% used)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="680" width="590" height="170" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Dual-stack (required, B-07 - not designed):&lt;/b&gt; one private IPv6 ULA prefix (RFC 4193) generated once; a /64 for the node network with static addresses (no router, no DHCPv6 - 3.54); IPv6 pod, service and LoadBalancer ranges; node IPs explicit for both families. Must be in the bootstrap config - the ranges cannot change afterwards.&lt;br&gt;&lt;b&gt;Geo-diverse sites (option):&lt;/b&gt; both VIPs are layer-2 announcements, so they need one layer-2 network across locations, or a different mechanism." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="1620" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
