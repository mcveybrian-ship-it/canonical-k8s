<mxfile host="make-diagrams.py" agent="make-diagrams.py" version="24.0.0"><diagram id="3-kubernetes-cluster" name="3 - Kubernetes cluster"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Kubernetes cluster - Canonical Kubernetes 1.36.4 (planned, B-07)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Embedded etcd on three control planes · Cilium · Gateway API via the built-in ck-gateway · images only from Harbor · database outside the cluster on Patroni." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="160" as="geometry"/></mxCell><mxCell id="c5" value="built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c6" value="planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c7" value="lab only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c8" value="option" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c9" value="Generated by docs/diagrams/make-diagrams.py from enclave-addresses.env and vm-specs.env - re-run it, do not hand-edit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="182" width="250" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Users and clients&lt;/b&gt;&lt;br&gt;enclave network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Gateway VIP&lt;/b&gt; - LoadBalancer address from 10.2.20.200-250&lt;br&gt;layer-2 announced, moves on node failure" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="300" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ck-gateway&lt;/b&gt; (Gateway API, Cilium)&lt;br&gt;HTTPRoutes for the app · *.apps.enclave.internal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="360" height="60" as="geometry"/></mxCell><mxCell id="c13" value="https" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;FIPS condition (Q-CORE (i))&lt;/b&gt;&lt;br&gt;if the gateway's TLS is not FIPS-validated: two HAProxy VMs on Ubuntu Pro FIPS + keepalived VIP terminate TLS in front" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="95" width="270" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;CONTROL PLANE&lt;/b&gt; - 3 VMs, one per host-1..3 (anti-affinity) · tainted: no app pods (H3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="640" height="330" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Kubernetes API VIP 10.2.20.170&lt;/b&gt; - keepalived VRRP across the three (not kube-vip)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="580" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;k8s-cp-01&lt;/b&gt;&lt;br&gt;10.2.20.171&lt;br&gt;on host-1&lt;br&gt;&lt;br&gt;kube-apiserver&lt;br&gt;scheduler · controller-manager&lt;br&gt;&lt;b&gt;etcd member&lt;/b&gt;&lt;br&gt;keepalived" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="180" height="200" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;k8s-cp-02&lt;/b&gt;&lt;br&gt;10.2.20.172&lt;br&gt;on host-2&lt;br&gt;&lt;br&gt;kube-apiserver&lt;br&gt;scheduler · controller-manager&lt;br&gt;&lt;b&gt;etcd member&lt;/b&gt;&lt;br&gt;keepalived" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="255" y="310" width="180" height="200" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;k8s-cp-03&lt;/b&gt;&lt;br&gt;10.2.20.173&lt;br&gt;on host-3&lt;br&gt;&lt;br&gt;kube-apiserver&lt;br&gt;scheduler · controller-manager&lt;br&gt;&lt;b&gt;etcd member&lt;/b&gt;&lt;br&gt;keepalived" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="310" width="180" height="200" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c17" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="580" height="0" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;WORKERS&lt;/b&gt; - 4 VMs, one per host · app pods spread across them" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="960" height="560" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor