rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="965" y="492" width="200" height="44" as="geometry"/></mxCell><mxCell id="c43" value="Ceph OSD (raw device, dmcrypt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="965" y="542" width="200" height="44" as="geometry"/></mxCell><mxCell id="c44" value="Ceph mon + mgr" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="965" y="592" width="200" height="44" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="240" width="220" height="500" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;k8s-wk-03&lt;/b&gt; 10.2.20.183 · host-3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="248" width="200" height="40" as="geometry"/></mxCell><mxCell id="c47" value="app services (replica)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="292" width="200" height="44" as="geometry"/></mxCell><mxCell id="c48" value="Redis replica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="342" width="200" height="44" as="geometry"/></mxCell><mxCell id="c49" value="Gateway data path (Cilium)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="392" width="200" height="44" as="geometry"/></mxCell><mxCell id="c50" value="ceph-csi node plugin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="442" width="200" height="44" as="geometry"/></mxCell><mxCell id="c51" value="Ceph OSD (raw device, dmcrypt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="492" width="200" height="44" as="geometry"/></mxCell><mxCell id="c52" value="Ceph mon + mgr" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="542" width="200" height="44" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1425" y="240" width="220" height="500" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;k8s-wk-04&lt;/b&gt; 10.2.20.184 · host-4" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1435" y="248" width="200" height="40" as="geometry"/></mxCell><mxCell id="c55" value="app services (replica)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="292" width="200" height="44" as="geometry"/></mxCell><mxCell id="c56" value="Redis replica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="342" width="200" height="44" as="geometry"/></mxCell><mxCell id="c57" value="pgAdmin (admin ns)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="392" width="200" height="44" as="geometry"/></mxCell><mxCell id="c58" value="Gateway data path (Cilium)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="442" width="200" height="44" as="geometry"/></mxCell><mxCell id="c59" value="ceph-csi node plugin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="492" width="200" height="44" as="geometry"/></mxCell><mxCell id="c60" value="Ceph OSD (raw device, dmcrypt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="542" width="200" height="44" as="geometry"/></mxCell><mxCell id="c61" value="Ceph MDS standby" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1435" y="592" width="200" height="44" as="geometry"/></mxCell><mxCell id="c62" value="routes to app pods" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c12" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Volumes (ceph-csi)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;CephFS - ReadWriteMany&lt;/b&gt;: every app PVC; the map store (default 10 GB, adjustable) shared by the app's file server and GeoServer&lt;br&gt;• RBD - ReadWriteOnce: available if a workload wants block storage&lt;br&gt;• replica 3 across four OSD nodes (one per worker), encrypted OSDs&lt;br&gt;• a single-writer pod on a DEAD worker needs the node marked &lt;b&gt;out-of-service&lt;/b&gt;: automatic through the BMC in production, a manual step in the lab (H2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="640" height="200" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;svc-harbor-01&lt;/b&gt; 10.2.20.163&lt;br&gt;Harbor: every image (≈1 GB for the app stack), containerd points here before bootstrap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="380" height="90" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;pg-01..03&lt;/b&gt; 10.2.20.165-167 · Patroni, synchronous&lt;br&gt;the app's database - NOT in the cluster; libpq multi-host, 5432 allowed from the four workers only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="800" width="420" height="90" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;svc-obs-01&lt;/b&gt; 10.2.20.164&lt;br&gt;scrapes the nodes and Ceph from outside the cluster (planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="800" width="360" height="90" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;svc-mgmt-01&lt;/b&gt; 10.2.20.161&lt;br&gt;enclave DNS: *.apps → Gateway VIP · issuing CA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="800" width="370" height="90" as="geometry"/></mxCell><mxCell id="c68" value="image pulls" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c64" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c69" value="SQL (5432)" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c45" target="c65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c70" value="scrape" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c66" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Decided 2026-10-02 (B-07):&lt;/b&gt; HA target = any one host failure (H1) · BMC fencing in production, manual in the lab (H2) · control planes run no app pods (H3) · ingress = Gateway API on ck-gateway, the vendor's NGINX Ingress manifests converted with ingress2gateway 1.0 and shared with Azure · all PVCs RWX (CephFS) · Redis master + 3 replicas, one per worker · GeoServer in the cluster (it mounts the map store).&lt;br&gt;&lt;b&gt;Open before bootstrap:&lt;/b&gt; revision (K1, 3.26) · dual-stack ranges · the STIG's set-once items (anonymous kubelet auth off, audit policy, secrets encryption, Pod Security) · k8s ufw/PPSM tables (compose --harden refuses without them) · keepalived config." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="920" width="1620" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
