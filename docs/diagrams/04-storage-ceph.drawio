<mxfile host="make-diagrams.py" agent="make-diagrams.py" version="24.0.0"><diagram id="4-storage-ceph-" name="4 - Storage (Ceph)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Storage - Ceph from Ubuntu debs on the workers (planned, B-08)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Not MicroCeph (runbook 2.5). Ceph 19.2.3 from the enclave mirror; ceph-mds is there too (checked 2026-10-02)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="160" as="geometry"/></mxCell><mxCell id="c5" value="built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c6" value="planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c7" value="lab only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="154" width="120" height="22" as="geometry"/></mxCell