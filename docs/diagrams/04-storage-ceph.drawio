mxCell id="c22" value="&lt;b&gt;mgr&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="645" y="244" width="175" height="40" as="geometry"/></mxCell><mxCell id="c23" value="ceph-csi node plugin&lt;br&gt;RBD + CephFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="340" width="360" height="60" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="140" width="380" height="270" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;k8s-wk-03&lt;/b&gt; on host-3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="146" width="360" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;OSD&lt;/b&gt; - the host's raw M.2 partition p2 (~500 GB), passed through whole; every OSD the same declared size" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="176" width="360" height="60" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;mon&lt;/b&gt; (quorum)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="244" width="175" height="40" as="geometry"/></mxCell><mxCell id="c28" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="244" width="175" height="40" as="geometry"/></mxCell><mxCell id="c29" value="ceph-csi node plugin&lt;br&gt;RBD + CephFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="340" width="360" height="60" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="140" width="380" height="270" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;k8s-wk-04&lt;/b&gt; on host-4" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="146" width="360" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;OSD&lt;/b&gt; - the host's raw M.2 partition p2 (~500 GB), passed through whole; every OSD the same declared size" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="176" width="360" height="60" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;MDS standby&lt;/b&gt; (CephFS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="292" width="360" height="40" as="geometry"/></mxCell><mxCell id="c34" value="ceph-csi node plugin&lt;br&gt;RBD + CephFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="360" height="60" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Pools and classes&lt;/b&gt;&lt;br&gt;• CephFS data + metadata (replica 3) → StorageClass &lt;b&gt;ReadWriteMany&lt;/b&gt; - every app PVC&lt;br&gt;• RBD pool 'kubernetes' (128 PGs, replica 3) → StorageClass ReadWriteOnce&lt;br&gt;• the database is NOT on Ceph (pg-01..03 on encrypted local LVs)&lt;br&gt;• 60% fill rule: ~400 GB working at replica 3 from four ~500 GB OSDs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="790" height="180" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Networks&lt;/b&gt;&lt;br&gt;• public network (clients, mons): management 10.2.20.0/24&lt;br&gt;• cluster network (replication): storage 10.2.30.0/24 - needs br-storage on the hosts (planned, 3.16)&lt;br&gt;• lab: the OSDs share the host NVMe with the database volume (a documented waiver); remainders are evened at the smallest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="450" width="800" height="180" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;OPTION - Ceph stretch mode, if the hosts are spread across the complex&lt;/b&gt; (Ceph Squid docs)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="1620" height="420" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Site A&lt;/b&gt;&lt;br&gt;2 hosts · 2 OSD nodes&lt;br&gt;&lt;b&gt;2 monitors&lt;/b&gt;&lt;br&gt;2 copies of every object" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="480" height="220" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Site B&lt;/b&gt;&lt;br&gt;2 hosts · 2 OSD nodes&lt;br&gt;&lt;b&gt;2 monitors&lt;/b&gt;&lt;br&gt;2 copies of every object" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="710" width="480" height="220" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Site C - witness&lt;/b&gt; (a fifth, small machine)&lt;br&gt;&lt;b&gt;tie-breaker monitor&lt;/b&gt; only, no data&lt;br&gt;+ one Kubernetes etcd member and one Patroni etcd member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="710" width="520" height="220" as="geometry"/></mxCell><mxCell id="c41" value="synchronous replication" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="Five monitors (two per data site + the tie-breaker) · pools of &lt;b&gt;size 4, two copies per site&lt;/b&gt; - usable space falls from a third to a quarter of raw · when one site fails the survivor goes active alone · replicated pools only (no erasure coding) · OSDs at exactly two sites · SSD OSDs recommended. Latency between sites to be measured." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
