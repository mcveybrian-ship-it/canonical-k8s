<mxfile host="make-diagrams.py" agent="make-diagrams.py" version="24.0.0"><diagram id="5-ha-and-failure-domains" name="5 - HA and failure domains"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="HA - what survives what (decided H1: any one host failure)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Three quorum systems, each with one member on host-1..3. Losing any one host costs one vote in each - all keep quorum." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="160" as="geometry"/></mxCell><mxCell id="c5" value="built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c6" value="planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c7" value="lab only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c8" value="option" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c9" value="Generated by docs/diagrams/make-diagrams.py from enclave-addresses.env and vm-specs.env - re-run it, do not hand-edit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="182" width="250" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;quorum / role&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="330" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;host-1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;host-2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;host-3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;host-4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;witness (option)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Kubernetes etcd (control planes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="164" width="330" height="56" as="geometry"/></mxCell><mxCell id="c17" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c18" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c19" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c20" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c21" value="member*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c22" value="Patroni etcd (database DCS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="330" height="56" as="geometry"/></mxCell><mxCell id="c23" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c24" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c25" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c26" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c27" value="member*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c28" value="Ceph monitors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="292" width="330" height="56" as="geometry"/></mxCell><mxCell id="c29" value="mon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c30" value="mon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c31" value="mon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c32" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c33" value="tie-breaker*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c34" value="PostgreSQL (Patroni)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="356" width="330" height="56" as="geometry"/></mxCell><mxCell id="c35" value="pg-01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c36" value="pg-02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c37" value="pg-03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c38" value="backup store" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c39" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c40" value="Kubernetes workers / Ceph OSDs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="330" height="56" as="geometry"/></mxCell><mxCell id="c41" value="wk-01 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c42" value="wk-02 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c43" value="wk-03 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c44" value="wk-04 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c45" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c46" value="* the witness exists only in the geo-diverse option - a fifth, small physical machine in a third location." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="482" width="1640" height="30" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Four hosts (the plan)&lt;/b&gt;&lt;br&gt;• any &lt;b&gt;one&lt;/b&gt; host lost → every quorum holds, workloads reschedule, Ceph heals onto the remaining OSDs, Patroni fails over automatically (proven by a power cut, 2026-09-28)&lt;br&gt;• &lt;b&gt;two&lt;/b&gt; hosts lost → quorum lost → the cluster stops writing; data is safe and it resumes when a host returns&lt;br&gt;• a watcher VM on these four hosts adds nothing: a 4th member still survives only one loss, and 5 members on 4 hosts put two on one host&lt;br&gt;• during maintenance of one host there is no spare - a second failure then is an outage" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="800" height="230" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Geo-diverse option (2.8)&lt;/b&gt;&lt;br&gt;hosts split 2 + 2 across two locations → losing a location = losing two hosts. Without a witness, one location holds two of the three members and its loss stops everything.&lt;br&gt;With a &lt;b&gt;witness in a third location&lt;/b&gt; (one member of each quorum, no data) and &lt;b&gt;Ceph stretch mode&lt;/b&gt; (size 4, two copies per site), either data location can be lost. Build site-aware now (site per host, zone labels, Ceph datacenter buckets) so adding it later is configuration." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="810" height="230" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;FENCING A DEAD WORKER (H2)&lt;/b&gt; - a single-writer pod on a dead node stays 'terminating' forever until the node is marked out-of-service; Kubernetes requires the node be verified powered off first (kubernetes.io, node shutdown)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1640" height="330" as="geometry"/></mxCell><mxCell id="c50" value="worker's host stops responding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="240" height="70" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;production:&lt;/b&gt; ask that host's &lt;b&gt;BMC&lt;/b&gt; (Redfish/IPMI) - powered off?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="840" width="260" height="70" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;off&lt;/b&gt; → taint node.kubernetes.io/out-of-service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="820" width="300" height="50" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;on but unreachable&lt;/b&gt; → power it OFF through the BMC (fence), then taint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="890" width="300" height="60" as="geometry"/></mxCell><mxCell id="c54" value="pods force-deleted, volumes detached immediately → pods restart on surviving workers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="840" width="300" height="70" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;lab (no BMC):&lt;/b&gt; the same tool prints the checks and the command; a person confirms the host is really off before the taint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="960" width="640" height="70" as="geometry"/></mxCell><mxCell id="c56" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c51" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c52" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c50" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="Production needs: an isolated out-of-band BMC network, BMC credential custody, PPSM rows. Remove the taint by hand once the node is back (the docs require it)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="960" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
