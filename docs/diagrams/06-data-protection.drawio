<mxfile host="make-diagrams.py" agent="make-diagrams.py" version="24.0.0"><diagram id="6-data-protection" name="6 - Data protection"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Data protection - backups, copies and the audit trail" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="What exists today (solid), what is planned (dashed), and the lab's extra copy (dotted red)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="160" as="geometry"/></mxCell><mxCell id="c5" value="built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c6" value="planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c7" value="lab only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c8" value="option" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c9" value="Generated by docs/diagrams/make-diagrams.py from enclave-addresses.env and vm-specs.env - re-run it, do not hand-edit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="182" width="250" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;host-4's guests&lt;/b&gt;&lt;br&gt;svc-mgmt-01 · svc-repo-01 · svc-harbor-01 · svc-obs-01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;vm-backup.sh&lt;/b&gt; nightly 02:00 Central&lt;br&gt;incr · verify (new sets) · prune · weekly verify --all" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="380" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;/mnt/vmbackup&lt;/b&gt; on host-4&lt;br&gt;USB SSD, LUKS · 2 chains kept" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="110" width="330" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;second copy → host-1&lt;/b&gt;&lt;br&gt;write-only rrsync · svc-repo-01 skipped" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="240" width="330" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;third copy → lab-vault&lt;/b&gt;&lt;br&gt;10.2.30.170, storage network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="240" width="330" height="80" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="nightly · new files verified" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="nightly · lab only" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Copies verify only files not verified before (a ledger on host-4); the weekly verify re-reads both copies in full (--verify-all). Measured 2026-10-01: 182.4 GB first third copy in 38.6 min." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="860" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;pg-01..03&lt;/b&gt;&lt;br&gt;Patroni · the app's real records" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="330" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;pgBackRest store 1&lt;/b&gt; - host-4 /srv/pgbackrest/repo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="380" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;pgBackRest store 2&lt;/b&gt; - host-3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="380" height="60" as="geometry"/></mxCell><mxCell id="c23" value="WAL + backups" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;3.50:&lt;/b&gt; pgBackRest's repositories are NOT copied to the lab stores until repository encryption is on - they hold real records. Point-in-time restore proven from both stores (2026-09-28)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="360" width="700" height="130" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Kubernetes etcd&lt;/b&gt;&lt;br&gt;(planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="80" as="geometry"/></mxCell><mxCell id="c27" value="nightly etcd snapshot → the backup volume (rides the copies) + a cluster restore drill" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="540" width="380" height="80" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;CephFS / RBD volumes&lt;/b&gt; (planned): backup approach not yet designed - the app's state is in PostgreSQL; the map store is on CephFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="540" width="700" height="80" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;all 11 enclave machines&lt;/b&gt;&lt;br&gt;audit logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="330" height="80" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;audit offload → svc-obs-01&lt;/b&gt;&lt;br&gt;weekly · kept 1 year" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="680" width="380" height="80" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="Planned: continuous delivery (audisp-remote, N-2 step 2); syslog kept one year (3.37)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="680" width="700" height="80" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Records destruction (3.27, go-live gate):&lt;/b&gt; backups must age out within ~60 days - an age-based full every 30 days, two chains kept, a legal-hold switch, a disposal log - and every copy follows the source (--delete). Measured 2026-09-24: retention is currently UNBOUNDED (nightly runs are incremental, so no chain ever retires). Build owed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1610" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
