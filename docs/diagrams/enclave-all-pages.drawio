;" edge="1" parent="1" source="c34" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;k8s-cp-03&lt;/b&gt;&lt;br&gt;10.2.20.173&lt;br&gt;control plane · etcd member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="865" y="405" width="360" height="62" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;k8s-wk-03&lt;/b&gt;&lt;br&gt;10.2.20.183&lt;br&gt;worker · Ceph OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="865" y="475" width="360" height="62" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;pg-03&lt;/b&gt;&lt;br&gt;10.2.20.167&lt;br&gt;PostgreSQL 16 · Patroni · etcd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="865" y="545" width="360" height="62" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;svc-obs-01&lt;/b&gt;&lt;br&gt;10.2.20.164&lt;br&gt;Prometheus · Grafana · audit offload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="865" y="615" width="360" height="62" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;host-4&lt;/b&gt;  10.2.20.158" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="370" width="390" height="190" as="geometry"/></mxCell><mxCell id="c42" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c41" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c41" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;k8s-wk-04&lt;/b&gt;&lt;br&gt;10.2.20.184&lt;br&gt;worker · Ceph OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1275" y="405" width="360" height="62" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;svc-mgmt-01&lt;/b&gt;&lt;br&gt;10.2.20.161&lt;br&gt;enclave DNS · issuing CA · Pro contracts · NTP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1275" y="475" width="360" height="62" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Kubernetes (planned, B-07)&lt;/b&gt;&lt;br&gt;3 control planes (etcd, API VIP 10.2.20.170) · 4 workers&lt;br&gt;Gateway API (ck-gateway) on a LoadBalancer VIP · *.apps&lt;br&gt;Ceph on the workers: CephFS RWX + RBD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="520" height="130" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;PostgreSQL HA (built)&lt;/b&gt;&lt;br&gt;pg-01..03, Patroni + its own etcd, synchronous&lt;br&gt;backed up by pgBackRest to host-4 and host-3&lt;br&gt;Postgres 16 STIG: all 111 rules judged (2026-10-01)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="720" width="520" height="130" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Service VMs (built)&lt;/b&gt;&lt;br&gt;DNS · CA · mirror · Harbor · monitoring&lt;br&gt;every machine hardened (USG STIG + Evaluate-STIG)&lt;br&gt;lab: all four on host-4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="720" width="540" height="130" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Pages:&lt;/b&gt; 1 hosts and VMs · 2 networks · 3 Kubernetes cluster · 4 storage · 5 HA and failure domains · 6 data protection.&lt;br&gt;&lt;b&gt;HA target:&lt;/b&gt; any one host failure (H1). Option: a fifth witness in a third location if the hosts are spread across the complex (page 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="1620" height="110" as="geometry"/></mxCell><mxCell id="c50" value="Witness option: one Kubernetes etcd member, one Patroni etcd member and a Ceph tie-breaker monitor on a small machine in a third location - not decided (2.8)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="1620" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1-hosts-and-vms" name="1 - Hosts and VMs"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1290" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Hosts and VMs - where every guest runs" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Production placement (agreed 2026-09-20, backlog 2.9) above; the lab as built below. Anti-affinity: pg-01 pg-02 pg-03  and  k8s-cp-01 k8s-cp-02 k8s-cp-03." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notat