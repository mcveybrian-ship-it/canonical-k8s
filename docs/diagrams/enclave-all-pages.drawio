dth="380" height="270" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;k8s-wk-03&lt;/b&gt; on host-3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="146" width="360" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;OSD&lt;/b&gt; - the host's raw M.2 partition p2 (~500 GB), passed through whole; every OSD the same declared size" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="176" width="360" height="60" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;mon&lt;/b&gt; (quorum)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="244" width="175" height="40" as="geometry"/></mxCell><mxCell id="c28" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="244" width="175" height="40" as="geometry"/></mxCell><mxCell id="c29" value="ceph-csi node plugin&lt;br&gt;RBD + CephFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="340" width="360" height="60" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="140" width="380" height="270" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;k8s-wk-04&lt;/b&gt; on host-4" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="146" width="360" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;OSD&lt;/b&gt; - the host's raw M.2 partition p2 (~500 GB), passed through whole; every OSD the same declared size" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="176" width="360" height="60" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;MDS standby&lt;/b&gt; (CephFS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="292" width="360" height="40" as="geometry"/></mxCell><mxCell id="c34" value="ceph-csi node plugin&lt;br&gt;RBD + CephFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="360" height="60" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Pools and classes&lt;/b&gt;&lt;br&gt;• CephFS data + metadata (replica 3) → StorageClass &lt;b&gt;ReadWriteMany&lt;/b&gt; - every app PVC&lt;br&gt;• RBD pool 'kubernetes' (128 PGs, replica 3) → StorageClass ReadWriteOnce&lt;br&gt;• the database is NOT on Ceph (pg-01..03 on encrypted local LVs)&lt;br&gt;• 60% fill rule: ~400 GB working at replica 3 from four ~500 GB OSDs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="790" height="180" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Networks&lt;/b&gt;&lt;br&gt;• public network (clients, mons): management 10.2.20.0/24&lt;br&gt;• cluster network (replication): storage 10.2.30.0/24 - needs br-storage on the hosts (planned, 3.16)&lt;br&gt;• lab: the OSDs share the host NVMe with the database volume (a documented waiver); remainders are evened at the smallest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="450" width="800" height="180" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;OPTION - Ceph stretch mode, if the hosts are spread across the complex&lt;/b&gt; (Ceph Squid docs)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="1620" height="420" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Site A&lt;/b&gt;&lt;br&gt;2 hosts · 2 OSD nodes&lt;br&gt;&lt;b&gt;2 monitors&lt;/b&gt;&lt;br&gt;2 copies of every object" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="480" height="220" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Site B&lt;/b&gt;&lt;br&gt;2 hosts · 2 OSD nodes&lt;br&gt;&lt;b&gt;2 monitors&lt;/b&gt;&lt;br&gt;2 copies of every object" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="710" width="480" height="220" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Site C - witness&lt;/b&gt; (a fifth, small machine)&lt;br&gt;&lt;b&gt;tie-breaker monitor&lt;/b&gt; only, no data&lt;br&gt;+ one Kubernetes etcd member and one Patroni etcd member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="710" width="520" height="220" as="geometry"/></mxCell><mxCell id="c41" value="synchronous replication" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="Five monitors (two per data site + the tie-breaker) · pools of &lt;b&gt;size 4, two copies per site&lt;/b&gt; - usable space falls from a third to a quarter of raw · when one site fails the survivor goes active alone · replicated pools only (no erasure coding) · OSDs at exactly two sites · SSD OSDs recommended. Latency between sites to be measured." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5-ha-and-failure-domains" name="5 - HA and failure domains"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="HA - what survives what (decided H1: any one host failure)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Three quorum systems, each with one member on host-1..3. Losing any one host costs one vote in each - all keep quorum." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="160" as="geometry"/></mxCell><mxCell id="c5" value="built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c6" value="planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c7" value="lab only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c8" value="option" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c9" value="Generated by docs/diagrams/make-diagrams.py from enclave-addresses.env and vm-specs.env - re-run it, do not hand-edit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="182" width="250" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;quorum / role&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="330" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;host-1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;host-2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;host-3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;host-4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;witness (option)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="100" width="250" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Kubernetes etcd (control planes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="164" width="330" height="56" as="geometry"/></mxCell><mxCell id="c17" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c18" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c19" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c20" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c21" value="member*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="164" width="250" height="56" as="geometry"/></mxCell><mxCell id="c22" value="Patroni etcd (database DCS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="330" height="56" as="geometry"/></mxCell><mxCell id="c23" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c24" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c25" value="member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c26" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c27" value="member*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="228" width="250" height="56" as="geometry"/></mxCell><mxCell id="c28" value="Ceph monitors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="292" width="330" height="56" as="geometry"/></mxCell><mxCell id="c29" value="mon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c30" value="mon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c31" value="mon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c32" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c33" value="tie-breaker*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="292" width="250" height="56" as="geometry"/></mxCell><mxCell id="c34" value="PostgreSQL (Patroni)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="356" width="330" height="56" as="geometry"/></mxCell><mxCell id="c35" value="pg-01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c36" value="pg-02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c37" value="pg-03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c38" value="backup store" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c39" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="356" width="250" height="56" as="geometry"/></mxCell><mxCell id="c40" value="Kubernetes workers / Ceph OSDs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="330" height="56" as="geometry"/></mxCell><mxCell id="c41" value="wk-01 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c42" value="wk-02 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c43" value="wk-03 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c44" value="wk-04 · OSD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c45" value="-" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="420" width="250" height="56" as="geometry"/></mxCell><mxCell id="c46" value="* the witness exists only in the geo-diverse option - a fifth, small physical machine in a third location." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="482" width="1640" height="30" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Four hosts (the plan)&lt;/b&gt;&lt;br&gt;• any &lt;b&gt;one&lt;/b&gt; host lost → every quorum holds, workloads reschedule, Ceph heals onto the remaining OSDs, Patroni fails over automatically (proven by a power cut, 2026-09-28)&lt;br&gt;• &lt;b&gt;two&lt;/b&gt; hosts lost → quorum lost → the cluster stops writing; data is safe and it resumes when a host returns&lt;br&gt;• a watcher VM on these four hosts adds nothing: a 4th member still survives only one loss, and 5 members on 4 hosts put two on one host&lt;br&gt;• during maintenance of one host there is no spare - a second failure then is an outage" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="800" height="230" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Geo-diverse option (2.8)&lt;/b&gt;&lt;br&gt;hosts split 2 + 2 across two locations → losing a location = losing two hosts. Without a witness, one location holds two of the three members and its loss stops everything.&lt;br&gt;With a &lt;b&gt;witness in a third location&lt;/b&gt; (one member of each quorum, no data) and &lt;b&gt;Ceph stretch mode&lt;/b&gt; (size 4, two copies per site), either data location can be lost. Build site-aware now (site per host, zone labels, Ceph datacenter buckets) so adding it later is configuration." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="810" height="230" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;FENCING A DEAD WORKER (H2)&lt;/b&gt; - a single-writer pod on a dead node stays 'terminating' forever until the node is marked out-of-service; Kubernetes requires the node be verified powered off first (kubernetes.io, node shutdown)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1640" height="330" as="geometry"/></mxCell><mxCell id="c50" value="worker's host stops responding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="240" height="70" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;production:&lt;/b&gt; ask that host's &lt;b&gt;BMC&lt;/b&gt; (Redfish/IPMI) - powered off?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="840" width="260" height="70" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;off&lt;/b&gt; → taint node.kubernetes.io/out-of-service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="820" width="300" height="50" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;on but unreachable&lt;/b&gt; → power it OFF through the BMC (fence), then taint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="890" width="300" height="60" as="geometry"/></mxCell><mxCell id="c54" value="pods force-deleted, volumes detached immediately → pods restart on surviving workers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="840" width="300" height="70" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;lab (no BMC):&lt;/b&gt; the same tool prints the checks and the command; a person confirms the host is really off before the taint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="960" width="640" height="70" as="geometry"/></mxCell><mxCell id="c56" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c51" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c52" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c50" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="Production needs: an isolated out-of-band BMC network, BMC credential custody, PPSM rows. Remove the taint by hand once the node is back (the docs require it)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="960" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6-data-protection" name="6 - Data protection"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Data protection - backups, copies and the audit trail" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="What exists today (solid), what is planned (dashed), and the lab's extra copy (dotted red)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="160" as="geometry"/></mxCell><mxCell id="c5" value="built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c6" value="planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="126" width="120" height="22" as="geometry"/></mxCell><mxCell id="c7" value="lab only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c8" value="option" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1840" y="154" width="120" height="22" as="geometry"/></mxCell><mxCell id="c9" value="Generated by docs/diagrams/make-diagrams.py from enclave-addresses.env and vm-specs.env - re-run it, do not hand-edit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="182" width="250" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;host-4's guests&lt;/b&gt;&lt;br&gt;svc-mgmt-01 · svc-repo-01 · svc-harbor-01 · svc-obs-01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;vm-backup.sh&lt;/b&gt; nightly 02:00 Central&lt;br&gt;incr · verify (new sets) · prune · weekly verify --all" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="380" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;/mnt/vmbackup&lt;/b&gt; on host-4&lt;br&gt;USB SSD, LUKS · 2 chains kept" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="110" width="330" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;second copy → host-1&lt;/b&gt;&lt;br&gt;write-only rrsync · svc-repo-01 skipped" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="240" width="330" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;third copy → lab-vault&lt;/b&gt;&lt;br&gt;10.2.30.170, storage network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="240" width="330" height="80" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="nightly · new files verified" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="nightly · lab only" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;dashPattern=1 3;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Copies verify only files not verified before (a ledger on host-4); the weekly verify re-reads both copies in full (--verify-all). Measured 2026-10-01: 182.4 GB first third copy in 38.6 min." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="860" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;pg-01..03&lt;/b&gt;&lt;br&gt;Patroni · the app's real records" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="330" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;pgBackRest store 1&lt;/b&gt; - host-4 /srv/pgbackrest/repo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="380" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;pgBackRest store 2&lt;/b&gt; - host-3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="380" height="60" as="geometry"/></mxCell><mxCell id="c23" value="WAL + backups" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;3.50:&lt;/b&gt; pgBackRest's repositories are NOT copied to the lab stores until repository encryption is on - they hold real records. Point-in-time restore proven from both stores (2026-09-28)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="360" width="700" height="130" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Kubernetes etcd&lt;/b&gt;&lt;br&gt;(planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="80" as="geometry"/></mxCell><mxCell id="c27" value="nightly etcd snapshot → the backup volume (rides the copies) + a cluster restore drill" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="540" width="380" height="80" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;CephFS / RBD volumes&lt;/b&gt; (planned): backup approach not yet designed - the app's state is in PostgreSQL; the map store is on CephFS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="540" width="700" height="80" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;all 11 enclave machines&lt;/b&gt;&lt;br&gt;audit logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="330" height="80" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;audit offload → svc-obs-01&lt;/b&gt;&lt;br&gt;weekly · kept 1 year" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="680" width="380" height="80" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="Planned: continuous delivery (audisp-remote, N-2 step 2); syslog kept one year (3.37)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="680" width="700" height="80" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Records destruction (3.27, go-live gate):&lt;/b&gt; backups must age out within ~60 days - an age-based full every 30 days, two chains kept, a legal-hold switch, a disposal log - and every copy follows the source (--delete). Measured 2026-09-24: retention is currently UNBOUNDED (nightly runs are incremental, so no chain ever retires). Build owed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1610" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
