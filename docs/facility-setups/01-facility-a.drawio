<mxfile host="make-diagrams.py" agent="make-diagrams.py" version="24.0.0"><diagram id="1-normal-operation" name="1 - Normal operation"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Facility A - 1. Normal operation: one closed system across sites" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="The main facility and 4-10 identical external sites, linked to each other too. Every site works on its own copy; the links carry sync." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="260" as="geometry"/></mxCell><mxCell id="c5" value="exists today" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="128" width="250" height="24" as="geometry"/></mxCell><mxCell id="c6" value="designed, not built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="158" width="250" height="24" as="geometry"/></mxCell><mxCell id="c7" value="still open" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="188" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1714" y="220" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="link cut (disconnect)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1744" y="218" width="210" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Answers in docs/facility-setups/01-facility-a.env; the design in 01-facility-a.md. GENERATED by facility-design.py - change an answer and rebuild, never edit this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="252" width="250" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ONE CLOSED SYSTEM, ONE AUTHORIZATION&lt;/b&gt; - no egress in any state (A2b)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1640" height="780" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835" y="893" width="30" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;OUTSIDE&lt;/b&gt; - internet and every other network. No connection from any site, in any state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#cc9999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#884444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="935" width="1640" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;MAIN FACILITY&lt;/b&gt; - the internal system, the system of record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="640" height="600" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Mission application (COTS)&lt;/b&gt;&lt;br&gt;on Kubernetes - 3 control planes, 4 workers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="195" width="580" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;PostgreSQL HA&lt;/b&gt; - pg-01..03, Patroni, synchronous&lt;br&gt;the system of record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="580" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;DNS - CA - mirror - Harbor - monitoring - time master" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="385" width="580" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Backups&lt;/b&gt; - vm-backup.sh - pgBackRest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="580" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Sync hub&lt;/b&gt; - built, not bought (A4)&lt;br&gt;field merge - staging - checks - review queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="555" width="580" height="85" as="geometry"/></mxCell><mxCell id="c20" value="Today's enclave, unchanged in shape." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="655" width="580" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXTERNAL SITE 1&lt;/b&gt; - lead during a disconnect (A10b)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="640" height="240" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;2 hosts + witness - GPS clock - UPS - fits a locking cabinet&lt;/b&gt; (A9)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="185" width="600" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Mission application&lt;/b&gt; - the whole of it&lt;br&gt;&lt;b&gt;Local database&lt;/b&gt; - a full copy of every record, own number range" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="245" width="600" height="70" as="geometry"/></mxCell><mxCell id="c24" value="own monitoring - backups - CRL cache - TPM unlock, unattended restart" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="325" width="600" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;EXTERNAL SITE 2&lt;/b&gt; - backup lead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="410" width="640" height="240" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;2 hosts + witness - GPS clock - UPS - fits a locking cabinet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="445" width="600" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Mission application&lt;/b&gt; - the whole of it&lt;br&gt;&lt;b&gt;Local database&lt;/b&gt; - a full copy of every record, own number range" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="505" width="600" height="70" as="geometry"/></mxCell><mxCell id="c28" value="own monitoring - backups - CRL cache - TPM unlock, unattended restart" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="585" width="600" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;... SITES 3 to N&lt;/b&gt; - 4-10 in all (A1a), identical: one build procedure, one parameter file per site" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="670" width="640" height="80" as="geometry"/></mxCell><mxCell id="c30" value="own fibre, controlled ground - sync" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=3;fontSize=11;" edge="1" parent="1" source="c14" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=3;fontSize=11;" edge="1" parent="1" source="c14" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=3;fontSize=11;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="mesh (A10)" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=3;fontSize=11;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Every site always works on its local copy&lt;/b&gt;; the links carry sync. When the main disconnects, sync with it pauses - nothing at the site switches over." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="260" height="170" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Link (A2a):&lt;/b&gt; no bulk link encryption needed for crossing uncontrolled space; the services' own TLS still protects the traffic" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="540" width="260" height="130" as="geometry"/></mxCell><mxCell id="c36" value="Answers in docs/facility-setups/01-facility-a.env; the design in 01-facility-a.md. GENERATED by facility-design.py - change an answer and rebuild, never edit this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="1640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-disconnected" name="2 - Disconnected"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Facility A - 2. Disconnected: the main has cut the link at will, the sites sync through the lead" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Every site keeps running, untended up to 45 days (A5, A8)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="260" as="geometry"/></mxCell><mxCell id="c5" value="exists today" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="128" width="250" height="24" as="geometry"/></mxCell><mxCell id="c6" value="designed, not built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="158" width="250" height="24" as="geometry"/></mxCell><mxCell id="c7" value="still open" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="188" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1714" y="220" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="link cut (disconnect)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1744" y="218" width="210" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Answers in docs/facility-setups/01-facility-a.env; the design in 01-facility-a.md. GENERATED by facility-design.py - change an answer and rebuild, never edit this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="252" width="250" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CLOSED&lt;/b&gt; - the main cut off; the external sites still linked to each other" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1640" height="780" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835" y="893" width="30" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;OUTSIDE&lt;/b&gt; - internet and every other network. No connection from any site, in any state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#cc9999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#884444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="935" width="1640" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;MAIN FACILITY&lt;/b&gt; - the internal system, the system of record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="640" height="600" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Mission application (COTS)&lt;/b&gt;&lt;br&gt;on Kubernetes - 3 control planes, 4 workers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="195" width="580" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;PostgreSQL HA&lt;/b&gt; - keeps writing&lt;br&gt;records numbered from the main's range" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="580" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;DNS - CA - mirror - Harbor - monitoring - time master" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="385" width="580" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Backups&lt;/b&gt; - vm-backup.sh - pgBackRest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="580" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Sync hub&lt;/b&gt; - built, not bought (A4)&lt;br&gt;field merge - staging - checks - review queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="555" width="580" height="85" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Ordered by:&lt;/b&gt; still open (A6c). &lt;b&gt;Cut:&lt;/b&gt; configuration first for speed, then a physical disconnect to make it certain (A6a)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="655" width="580" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXTERNAL SITE 1&lt;/b&gt; - lead during a disconnect (A10b)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="640" height="240" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Sync hub&lt;/b&gt; - the SAME component as the main's (A10b)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="185" width="600" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Local database&lt;/b&gt; - its own writes, plus every change from the sites that reach it; clashes flagged for the main's review queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="245" width="600" height="70" as="geometry"/></mxCell><mxCell id="c24" value="GPS clock - CRLs must outlast the disconnect - untended up to 45 days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="325" width="600" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;EXTERNAL SITE 2&lt;/b&gt; - backup lead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="410" width="640" height="240" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Mission application&lt;/b&gt; - keeps running" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="445" width="600" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Local database&lt;/b&gt; - its own writes, own number range; syncs with the lead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="505" width="600" height="70" as="geometry"/></mxCell><mxCell id="c28" value="power cut: restarts by itself - power-on, TPM unlock, ordered cold start (3.57)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="585" width="600" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;SITE N - cannot reach the lead&lt;/b&gt;: runs alone, its changes merge at the reconnect (A11: the same path as a cut fibre)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="670" width="640" height="80" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#cc0000;strokeWidth=3;dashed=1;" edge="1" parent="1" source="c14" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#cc0000;strokeWidth=3;dashed=1;" edge="1" parent="1" source="c14" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#cc0000;strokeWidth=3;dashed=1;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="845" y="343" width="30" height="30" as="geometry"/></mxCell><mxCell id="c34" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="845" y="476" width="30" height="30" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835" y="700" width="30" height="30" as="geometry"/></mxCell><mxCell id="c36" value="syncs through the lead" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c25" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Withdrawn access (A12):&lt;/b&gt; security phones the sites; a supervisor role in the application disables the user, and it syncs through the lead." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="260" height="170" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;A site that breaks:&lt;/b&gt; nobody fixes it during the disconnect (A8). Staff use paper, entered at the reconnect." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="525" width="260" height="130" as="geometry"/></mxCell><mxCell id="c39" value="Answers in docs/facility-setups/01-facility-a.env; the design in 01-facility-a.md. GENERATED by facility-design.py - change an answer and rebuild, never edit this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="1640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3-reconnect-and-reconcile" name="3 - Reconnect and reconcile"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Facility A - 3. Reconnect and reconcile" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Plugging the link back in starts nothing. What comes back is checked in staging, then merged." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="260" as="geometry"/></mxCell><mxCell id="c5" value="exists today" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="128" width="250" height="24" as="geometry"/></mxCell><mxCell id="c6" value="designed, not built" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="158" width="250" height="24" as="geometry"/></mxCell><mxCell id="c7" value="still open" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="188" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1714" y="220" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="link cut (disconnect)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1744" y="218" width="210" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Answers in docs/facility-setups/01-facility-a.env; the design in 01-facility-a.md. GENERATED by facility-design.py - change an answer and rebuild, never edit this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="252" width="250" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Step 1 - security&lt;/b&gt; ends the disconnect and restores the link (A6b). Nothing syncs." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="560" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Step 2 - the system owner or ISSO&lt;/b&gt; releases the merge, site by site, after the checks (A6b). After an unplanned loss, with no disconnect ordered: this step alone (A11)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="980" height="80" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;The lead's merged state&lt;/b&gt;&lt;br&gt;every change tagged with the site that made it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="500" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Changes from any site that ran alone&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="500" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Paper records&lt;/b&gt; from a site that broke (A8)&lt;br&gt;entered by hand" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="230" width="520" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;STAGING at the main facility&lt;/b&gt; - not the live system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="720" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Checks&lt;/b&gt; - checksums - valid records - content scan - clashes found" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="360" width="820" height="70" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Case 1 - new records&lt;/b&gt;&lt;br&gt;append. Numbers cannot collide: a range per site" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="380" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Case 2 - a record changed on one side only&lt;/b&gt;&lt;br&gt;apply" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="380" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Case 3 - both sides changed it&lt;/b&gt;&lt;br&gt;different fields: both apply. Same field: REVIEW QUEUE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="480" width="400" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Destroyed on one side, edited on the other&lt;/b&gt;&lt;br&gt;a clash: REVIEW QUEUE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="480" width="380" height="100" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Who works the queue&lt;/b&gt; - still open (A3c)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="610" width="380" height="60" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c18" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c18" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c18" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c18" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Internal system - the system of record&lt;/b&gt;&lt;br&gt;written through the product's own interfaces (V4), never its database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="630" width="840" height="80" as="geometry"/></mxCell><mxCell id="c33" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c23" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c24" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c25" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c26" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Then back out to every site&lt;/b&gt; - a full copy, two-way (A7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="750" width="840" height="60" as="geometry"/></mxCell><mxCell id="c38" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c32" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Why the database cannot do this:&lt;/b&gt; streaming replication has one writer - rejoining a promoted copy (pg_rewind) discards its writes. Logical replication stops at the first conflicting row. The merge is application logic." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="840" width="530" height="160" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Whatever the reason for the disconnect&lt;/b&gt;, the sites ran outside the main's control - and synced each other unchecked (A10b). Staging and checks come before the merge." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="840" width="530" height="160" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Product upgrades:&lt;/b&gt; the main and every site run the same version, and each upgrade is re-tested against the sync engine first - one coordinated event, never during a disconnect." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="840" width="540" height="160" as="geometry"/></mxCell><mxCell id="c42" value="Answers in docs/facility-setups/01-facility-a.env; the design in 01-facility-a.md. GENERATED by facility-design.py - change an answer and rebuild, never edit this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="1640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
