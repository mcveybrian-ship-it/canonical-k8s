<mxfile host="make-diagrams.py" agent="make-diagrams.py" version="24.0.0"><diagram id="1-normal-operation" name="1 - Normal operation"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Facility A - 1. Normal operation: one closed system across sites" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Every site is closed - no egress in any state (Brian, 2026-10-30). The sites are joined by a link that is part of the boundary." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="260" as="geometry"/></mxCell><mxCell id="c5" value="exists, or given in the scenario" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="128" width="250" height="24" as="geometry"/></mxCell><mxCell id="c6" value="proposed - not decided" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="158" width="250" height="24" as="geometry"/></mxCell><mxCell id="c7" value="open question (A1-A7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="188" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1714" y="220" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="link cut (lockdown)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1744" y="218" width="210" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Scenario, questions A1-A7 and the reasoning: docs/facility-setups/01-facility-a.md. Drawn for discussion: edit it in draw.io - unlike docs/diagrams, nothing generates this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="252" width="250" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CLOSED&lt;/b&gt; - A2: one accreditation boundary across all sites, or separate systems with an interconnection agreement?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1640" height="780" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835" y="893" width="30" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;OUTSIDE&lt;/b&gt; - internet and every other network. No connection from any site, in any state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#cc9999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#884444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="935" width="1640" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;MAIN FACILITY&lt;/b&gt; - the internal system, the system of record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="640" height="600" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Mission application (COTS)&lt;/b&gt;&lt;br&gt;on Kubernetes - 3 control planes, 4 workers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="195" width="580" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;PostgreSQL HA&lt;/b&gt; - pg-01..03, Patroni, synchronous&lt;br&gt;one writer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="305" width="580" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;DNS - CA - mirror - Harbor - monitoring (svc-obs-01) - time master" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="415" width="580" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Backups&lt;/b&gt; - vm-backup.sh - pgBackRest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="525" width="580" height="70" as="geometry"/></mxCell><mxCell id="c19" value="This is the enclave the repo builds today: four hosts, one site." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="615" width="580" height="115" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;EXTERNAL SITE 1&lt;/b&gt; - outside the facility perimeter, closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="640" height="250" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Mission application - local instance&lt;/b&gt; (A1: all of it, or part?)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="600" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Local database&lt;/b&gt; - the site always works on its own copy (proposal)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="260" width="600" height="60" as="geometry"/></mxCell><mxCell id="c23" value="time - monitoring - backups - CRL cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="600" height="55" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;EXTERNAL SITE 2&lt;/b&gt; - outside the facility perimeter, closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="640" height="250" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Mission application - local instance&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="460" width="600" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Local database&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="530" width="600" height="60" as="geometry"/></mxCell><mxCell id="c27" value="time - monitoring - backups - CRL cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="600" width="600" height="55" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;... site N&lt;/b&gt; - A1: how many sites, and how many users at each?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="640" height="60" as="geometry"/></mxCell><mxCell id="c29" value="closed link - sync while connected (A4)" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=3;fontSize=11;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="closed link" style="endArrow=none;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=3;fontSize=11;" edge="1" parent="1" source="c14" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Proposal:&lt;/b&gt; an external site &lt;b&gt;always&lt;/b&gt; works on its local copy and the link carries sync. A lockdown then pauses sync. The alternative - use the main system, switch to local when cut - makes the switch-over happen during an incident, the least-tested moment there is." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="260" height="180" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;A2:&lt;/b&gt; what carries the link - fibre, a leased circuit, an encrypted tunnel? Through space the facility does not control, it needs FIPS-validated encryption." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="260" height="190" as="geometry"/></mxCell><mxCell id="c33" value="Scenario, questions A1-A7 and the reasoning: docs/facility-setups/01-facility-a.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="1640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-lockdown" name="2 - Lockdown"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Facility A - 2. Lockdown: the link is cut, every site runs alone" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Both sides keep running and keep writing to their own records. Nothing crosses until the reconnect." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="260" as="geometry"/></mxCell><mxCell id="c5" value="exists, or given in the scenario" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="128" width="250" height="24" as="geometry"/></mxCell><mxCell id="c6" value="proposed - not decided" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="158" width="250" height="24" as="geometry"/></mxCell><mxCell id="c7" value="open question (A1-A7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="188" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1714" y="220" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="link cut (lockdown)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1744" y="218" width="210" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Scenario, questions A1-A7 and the reasoning: docs/facility-setups/01-facility-a.md. Drawn for discussion: edit it in draw.io - unlike docs/diagrams, nothing generates this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="252" width="250" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CLOSED&lt;/b&gt; - and now closed per site" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1640" height="780" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835" y="893" width="30" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;OUTSIDE&lt;/b&gt; - internet and every other network. No connection from any site, in any state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#cc9999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#884444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="935" width="1640" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;MAIN FACILITY&lt;/b&gt; - the internal system, the system of record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="640" height="600" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Mission application (COTS)&lt;/b&gt;&lt;br&gt;on Kubernetes - 3 control planes, 4 workers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="195" width="580" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;PostgreSQL HA&lt;/b&gt; - keeps writing&lt;br&gt;record numbers from the main site's range" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="305" width="580" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;DNS - CA - mirror - Harbor - monitoring (svc-obs-01) - time master" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="415" width="580" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Backups&lt;/b&gt; - vm-backup.sh - pgBackRest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="525" width="580" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Record numbers&lt;/b&gt; are decided &lt;b&gt;before&lt;/b&gt; the first lockdown: a range or prefix per site. Afterwards there are already two record 1042s." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="615" width="580" height="115" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;EXTERNAL SITE 1&lt;/b&gt; - outside the facility perimeter, closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="640" height="250" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Mission application&lt;/b&gt; - keeps running alone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="600" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Local database&lt;/b&gt; - writes locally, from this site's number range; every change since the cut is kept for the merge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="260" width="600" height="60" as="geometry"/></mxCell><mxCell id="c23" value="own time source - own monitoring - own backups - cached CRLs age (A5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="600" height="55" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;EXTERNAL SITE 2&lt;/b&gt; - outside the facility perimeter, closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="640" height="250" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Mission application&lt;/b&gt; - keeps running alone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="460" width="600" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Local database&lt;/b&gt; - writes locally, from this site's number range" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="530" width="600" height="60" as="geometry"/></mxCell><mxCell id="c27" value="own time source - own monitoring - own backups - cached CRLs age (A5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="600" width="600" height="55" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;... site N&lt;/b&gt; - the same, alone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="640" height="60" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#cc0000;strokeWidth=3;dashed=1;fontSize=11;fontColor=#cc0000;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#cc0000;strokeWidth=3;dashed=1;fontSize=11;fontColor=#cc0000;" edge="1" parent="1" source="c14" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="845" y="345" width="30" height="30" as="geometry"/></mxCell><mxCell id="c32" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="845" y="483" width="30" height="30" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;A6:&lt;/b&gt; who declares the lockdown, and is the link cut physically or by policy?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="260" height="130" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;A5:&lt;/b&gt; hours, days or weeks? It sizes each site's storage, backups, clock drift and CRL freshness." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="260" height="110" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;One host per site:&lt;/b&gt; a host failure during a lockdown stops that site (A1)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="645" width="260" height="105" as="geometry"/></mxCell><mxCell id="c36" value="Scenario, questions A1-A7 and the reasoning: docs/facility-setups/01-facility-a.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="1640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3-reconnect-and-reconcile" name="3 - Reconnect and reconcile"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Facility A - 3. Reconnect and reconcile" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1640" height="36" as="geometry"/></mxCell><mxCell id="c3" value="What comes back ran outside the facility's control. It lands in staging, is checked, and is merged by the application - not replicated straight in." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Notation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="270" height="260" as="geometry"/></mxCell><mxCell id="c5" value="exists, or given in the scenario" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="128" width="250" height="24" as="geometry"/></mxCell><mxCell id="c6" value="proposed - not decided" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="158" width="250" height="24" as="geometry"/></mxCell><mxCell id="c7" value="open question (A1-A7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="188" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=mxgraph.basic.x;fillColor=#ff6666;strokeColor=#cc0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1714" y="220" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="link cut (lockdown)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1744" y="218" width="210" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Scenario, questions A1-A7 and the reasoning: docs/facility-setups/01-facility-a.md. Drawn for discussion: edit it in draw.io - unlike docs/diagrams, nothing generates this file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="252" width="250" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;A named person authorises the reconnect&lt;/b&gt;&lt;br&gt;(A6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="260" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Each external site exports its changes since the cut&lt;/b&gt;&lt;br&gt;one set per site, checksummed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="290" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;STAGING at the main facility&lt;/b&gt;&lt;br&gt;not the live system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="300" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Checks&lt;/b&gt;&lt;br&gt;checksums - valid records - content scan - conflicts found" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="320" height="90" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Case 1 - new records&lt;/b&gt;&lt;br&gt;append. Safe only if record numbers cannot collide (a range per site, page 2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="480" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Case 2 - changes to records the main side did not touch&lt;/b&gt;&lt;br&gt;apply on top" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="480" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Case 3 - both sides changed the same record&lt;/b&gt;&lt;br&gt;REVIEW QUEUE: a person decides. &quot;Last writer wins&quot; silently drops one side's change - only as a stated, accepted loss" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="560" height="110" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Internal system - the system of record&lt;/b&gt;&lt;br&gt;written through the application. A4: does the vendor's product do this merge, or does it have to be built?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="900" height="90" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c18" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c19" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Then out to the external sites&lt;/b&gt; - the main side's records and reference data (A7: one-way or two-way?)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="900" height="80" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Why the database cannot do this:&lt;/b&gt; streaming replication, which Patroni runs, has one writer. Promote a cut-off copy and there are two histories; rejoining it (pg_rewind) discards its writes. Logical replication copies row changes but stops at the first conflicting row - it does not decide who wins. The merge is application logic." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="800" height="170" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;A lockdown is a security event.&lt;/b&gt; For its length the external site ran outside the facility's control. Staging and checks come before the merge, and the reconnect is a decision with a name on it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffe0;strokeColor=#b3b300;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="780" width="810" height="170" as="geometry"/></mxCell><mxCell id="c32" value="Scenario, questions A1-A7 and the reasoning: docs/facility-setups/01-facility-a.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="1640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
