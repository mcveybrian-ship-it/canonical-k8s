# =========================================================================================
# credentials.env.example - the site credentials file, KEY NAMES ONLY (backlog 3.32).
#
# THIS EXAMPLE IS PUBLIC AND HOLDS NO VALUE. The real file is credentials.env and must never
# be committed, pushed, or copied into a runtime directory - .gitignore, the pre-push hook,
# push-repo-to-host.sh and install-runtime.sh all refuse it (tested 2026-09-26).
#
# WHAT IT IS FOR
#
#   Every secret the rebuild would otherwise ask someone to TYPE. With this file present, the
#   hardening runs with nobody at the keyboard; without it, every script prompts exactly as
#   before. Precedence everywhere: environment variable > this file > prompt.
#
#   HASHES WHEREVER A HASH WORKS. A value appears in plain text only where the consumer needs
#   the real thing (marked REAL VALUE below). The passwords behind the hashes are never
#   written anywhere; the emergency ones exist only in their sealed envelopes.
#
# LIFE CYCLE (procedure: docs/airgap-media.md, credential custody)
#
#   1. MADE on build-01 by scripts/transfer/make-credentials.sh, two people present. Never by hand.
#   2. CARRIED into the gap on registered, custody-controlled media.
#   3. PLACED on each target as /etc/enclave/credentials.env, owner root, mode 600 - the
#      scripts REFUSE any other owner or mode (stig-tailor.sh cred_get).
#   4. DELETED from the target once hardening has succeeded; the hashes then live only in
#      /etc/shadow and GRUB's config, where they belong.
#   5. The media is WIPED and the register entry closed, with a witness (MP-6).
#
# FORMAT: KEY='value' - single quotes, one per line. Parsed, never sourced: this is data.
# =========================================================================================

# ---- GRUB - enclave-wide ----------------------------------------------------------------
# HASH, from grub-mkpasswd-pbkdf2 (grub.pbkdf2.sha512.<iter>.<salt>.<hash>, upper-case hex).
# Read by: stig-tailor.sh grubpw set (05-harden-host.sh step `grub`). Shape is checked.
GRUB_PASSWORD_HASH=''

# ---- the second named administrator (ADMIN2_USER in facility-profile.env) -----------------
# HASH, SHA-512 crypt ($6$...). Read by: stig-tailor.sh accounts create (step `accounts`).
ADMIN2_PASSWORD_HASH=''

# ---- the console-only emergency account - ONE PER MACHINE, never shared ------------------
# HASH, SHA-512 crypt ($6$...). The key names the machine: hostname upper-cased, '-' -> '_'.
# There is deliberately NO shared fallback key (acting AO, 2026-09-23): one envelope must
# never open two machines. Each password is chosen by two custodians and sealed per machine.
# Read by: stig-tailor.sh accounts create (step `accounts`).
BREAKGLASS_PASSWORD_HASH_HOST_1=''
BREAKGLASS_PASSWORD_HASH_HOST_2=''
BREAKGLASS_PASSWORD_HASH_HOST_3=''
BREAKGLASS_PASSWORD_HASH_HOST_4=''
BREAKGLASS_PASSWORD_HASH_SVC_MGMT_01=''
BREAKGLASS_PASSWORD_HASH_SVC_REPO_01=''
BREAKGLASS_PASSWORD_HASH_SVC_HARBOR_01=''
BREAKGLASS_PASSWORD_HASH_SVC_OBS_01=''
# ...and one for each cluster guest when B-06 builds them, e.g.
# BREAKGLASS_PASSWORD_HASH_K8S_CP_01=''   BREAKGLASS_PASSWORD_HASH_PG_01=''

# ---- the VM admin account set at compose time ----------------------------------------------
# HASH, SHA-512 crypt. Today read from the ENVIRONMENT by 03-compose-vm.sh
# (VM_ADMIN_PASSWORD_HASH); reading it from this file is still to come (3.32 Part 2).
VM_ADMIN_PASSWORD_HASH=''

# ---- Harbor (svc-harbor-01) - REAL VALUES: harbor.yml needs the passwords themselves --------
# Today typed through set-config-secret.sh; reading them from here is still to come (Part 2).
HARBOR_ADMIN_PASSWORD=''
HARBOR_DB_PASSWORD=''

# ---- Grafana (svc-obs-01) - REAL VALUE ----------------------------------------------------
# Today set by hand at first login; reading it from here is still to come (3.32 Part 2).
GRAFANA_ADMIN_PASSWORD=''

# ---- deliberately NOT in this file --------------------------------------------------------
# LUKS_PASSPHRASE       - the disk passphrase lives in host-params.env on the seed, because the
#                         installer needs it before any of this exists. Same custody rules.
# PRO_TOKEN_FILE        - the Ubuntu Pro token is its own file (04-enclave-services.sh).
# CA_ROOT_PASS_FILE     - the root CA key passphrase is its own file, OUTSIDE the enclave
#                         (ca.sh; the root key never enters the gap).
