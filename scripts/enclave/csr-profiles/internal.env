# CSR profile: the enclave's own internal CA. This is the default.
#
# A profile decides what a CSR LOOKS LIKE - subject DN, key size, digest. It does not decide
# who signs it. That separation is the point: the same `ca.sh request` produces a CSR for
# this CA or for a site's registration authority, and only the profile changes.
CSR_COUNTRY='US'
CSR_ORG='McVey Consulting'
CSR_OU='Enclave PKI'
CSR_KEY_BITS='3072'
CSR_DIGEST='sha256'

# Where the signed certificate comes back from. Documentation only - nothing reads it - but
# it is the first question asked when a CSR has been sitting in /etc/ssl/enclave for a week.
CSR_SIGNED_BY='ca.sh sign-server, on svc-mgmt-01'
