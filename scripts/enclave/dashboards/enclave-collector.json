{
  "uid": "enclave-collector",
  "title": "Enclave collector - Prometheus, Alertmanager, Grafana",
  "description": "Generated by scripts/enclave/monitoring.sh. The monitoring stack watching itself. If this is wrong, every other dashboard is wrong and says nothing. Alertmanager and Grafana are scraped as of 2026-09-14 - before that neither was, and nothing could answer whether an alert was ever delivered.",
  "tags": [
    "enclave",
    "observability",
    "meta"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Is the collector doing its job",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Targets down",
      "description": "Scrape targets not answering. Everything else on every dashboard depends on this being zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count(up == 0) or vector(0)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Alerts firing",
      "description": "The ALERTS series only exists while something is pending or firing, so 'or vector(0)' is not cosmetic - without it this panel reads No data when all is well.",
