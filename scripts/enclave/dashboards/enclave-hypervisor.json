{
  "uid": "enclave-hypervisor",
  "title": "Enclave hypervisor - host-4 and VM backups",
  "description": "Generated by scripts/enclave/monitoring.sh. Edit the generator, not this dashboard. Backup metrics come from vm-backup.sh facts, called by monitoring.sh facts every 15 minutes; guest metrics come from prometheus-libvirt-exporter on the hypervisor.",
  "tags": [
    "enclave",
    "hypervisor",
    "backup"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Backup - did last night's backup actually land on the disk",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Domains with NO complete backup",
      "description": "Defined domains minus those holding at least one set with a MANIFEST.sha256. Anything above zero means a VM on this hypervisor is not protected.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "enclave_backup_domains_defined - enclave_backup_domains_protected",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest successful backup",
      "description": "Age of the newest COMPLETE set, for whichever domain is furthest behind. The job runs nightly at 02:00, so orange at 26 hours means one run was missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "max(time() - enclave_backup_last_success_seconds)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Destination mounted",
      "description": "1 = the LUKS volume is unlocked and mounted. After a reboot this is 0 for three separate reasons: usb-storage is STIG-blocked, LUKS is locked, and nothing types the passphrase. Fix with vm-backup.sh reattach.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "enclave_backup_dest_mounted",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Free at destination",
      "description": "Free space on the backup volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 200000000000
              },
              {
                "color": "green",
                "value": 500000000000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "enclave_backup_dest_avail_bytes",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Interrupted sets",
      "description": "Set directories with NO manifest - a run that started and never finished. A TMOUT-killed full backup leaves exactly this, and counting directories would call it a success.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(enclave_backup_sets_incomplete) or vector(0)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Nightly timer",
      "description": "1 = enclave-vm-backup.timer is active. A disabled timer is silent forever.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "enclave_backup_timer_enabled",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Per-domain backup state",
      "description": "One row per domain. A domain missing from this table entirely has no backup metrics at all - check that the destination is mounted before reading anything else here.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "since last success"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 93600
                    },
                    {
                      "color": "red",
                      "value": 180000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "complete sets"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "interrupted"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "newest set"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "checkpoints"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "enclave": true,
              "machine": true,
              "role": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "expr": "time() - enclave_backup_last_success_seconds",
          "format": "table",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        },
        {
          "expr": "enclave_backup_sets_complete",
          "format": "table",
          "refId": "B",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        },
        {
          "expr": "enclave_backup_sets_incomplete",
          "format": "table",
          "refId": "C",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        },
        {
          "expr": "enclave_backup_last_set_bytes",
          "format": "table",
          "refId": "D",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        },
        {
          "expr": "enclave_backup_checkpoints",
          "format": "table",
          "refId": "E",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time since the last successful backup, per domain",
      "description": "A healthy nightly job draws a sawtooth: climbing all day, dropping to near zero at 02:00. A line that climbs straight through 26 hours is a job that stopped running.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "width": 300,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "time() - enclave_backup_last_success_seconds",
          "legendFormat": "{{domain}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backup job running",
      "description": "1 while libvirt reports a job on the domain. This is the nightly window made visible - it should be a narrow block after 02:00, not a plateau. A job that never clears is the 'cannot acquire state change lock' state.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 23
