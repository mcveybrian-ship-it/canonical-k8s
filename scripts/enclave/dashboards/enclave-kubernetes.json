  {
   "type": "table",
   "title": "Every node in enclave-addresses.env",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "enclave-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "description": "Ready is the cluster's view (the VIP holder's check). Scraped is Prometheus reaching the node's own exporter - a node can be Ready and unscraped (firewall) or scraped and NotReady (kubelet).",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "enclave-prometheus"
     },
     "expr": "max by (node, role) (enclave_k8s_node_ready)",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "enclave-prometheus"
     },
     "expr": "max by (node) (label_replace(up{job=\"node\",role=~\"k8s-.*\"}, \"node\", \"$1\", \"machine\", \"(.*)\"))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "enclave-prometheus"
     },
     "expr": "max by (node) (label_replace(time() - node_boot_time_seconds{role=~\"k8s-.*\"}, \"node\", \"$1\", \"machine\", \"(.*)\"))",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "Ready",
       "Value #B": "Scraped",
       "Value #C": "Up for"
      },
      "indexByName": {
       "node": 0,
       "role": 1,
       "Value #A": 2,
       "Value #B": 3,
       "Value #C": 4
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Ready"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "Ready",
            "color": "green"
           },
           "0": {
            "text": "NOT READY",
            "color": "red"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Scraped"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "up",
            "color": "green"
           },
           "0": {
            "text": "DOWN",
            "color": "red"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Up for"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "footer": {
     "show": false
    },
    "sortBy": [
     {
      "displayName": "node",
      "desc": false
     }
    ]
   }
