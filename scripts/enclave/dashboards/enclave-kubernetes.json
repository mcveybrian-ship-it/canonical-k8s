  {
   "type": "table",
   "title": "Kubernetes alerts firing now",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "enclave-prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "description": "Each alert's action annotation says what to do - Prometheus's Alerts page or Alertmanager shows it in full.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "enclave-prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\",alertname=~\"Kubernetes.*|Keepalived.*\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "alertstate": true,
       "enclave": true,
       "job": true,
       "instance": true
      },
      "indexByName": {
       "alertname": 0,
       "severity": 1,
       "node": 2,
       "machine": 3,
       "check": 4
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "footer": {
     "show": false
    }
   }
