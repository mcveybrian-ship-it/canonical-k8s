    "type": "prometheus",
    "uid": "enclave-prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "enclave-prometheus"
     },
     "expr": "count(max by (node) (enclave_k8s_node_ready) == 0) or vector(0)",
     "instant": true,
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
