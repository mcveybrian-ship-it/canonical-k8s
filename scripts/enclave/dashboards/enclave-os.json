          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Operating system - host and guests",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU used",
      "description": "Percentage of CPU not idle, averaged across cores. Alert HighCPU fires above 85% for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "width": 300,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - (avg by (machine) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{machine}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory available",
      "description": "MemAvailable already accounts for reclaimable cache, so a low number here is real pressure. Alert MemoryPressure fires below 10%.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "width": 300,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{machine}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Load average (1m) per core",
      "description": "Load normalised by core count. Above 1.0 means more work queued than cores to run it.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "width": 300,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "node_load1 / on(machine) group_left count by (machine) (node_cpu_seconds_total{mode=\"idle\"})",
          "legendFormat": "{{machine}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Swap used",
      "description": "Sustained swap use on a server means memory is genuinely short.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "width": 300,
          "calcs": [
            "lastNotNull",
            "max"
