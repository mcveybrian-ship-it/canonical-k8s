        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "((node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / (node_memory_SwapTotal_bytes > 0)) * 100",
          "legendFormat": "{{machine}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Filesystems",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Free space now, tightest first",
      "description": "Every real filesystem on every machine. vfat is excluded - /boot/efi is tiny and static.",
      "datasource": {
        "type": "prometheus",
        "uid": "enclave-prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "displayName",
                "value": "free %"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "free %",
            "desc": false
          }
        ],
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "device": true,
              "fstype": true,
              "role": true
            },
            "indexByName": {
              "machine": 0,
              "mountpoint": 1,
              "Value": 2
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "(node_filesystem_avail_bytes{fstype!~\"vfat|tmpfs|squashfs|overlay\"} / node_filesystem_size_bytes) * 100",
          "refId": "A",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "enclave-prometheus"
          }
        }
      ]
    },
    {
