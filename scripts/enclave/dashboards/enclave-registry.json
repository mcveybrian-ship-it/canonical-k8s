      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "width": 300,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "node_systemd_unit_state{machine=\"svc-harbor-01\",name=\"docker.service\",state=\"active\"}",
          "legendFormat": "docker",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
