# =========================================================================================
# enclave-addresses.env - THE single source of truth for who is at which address.
#
# Change a value here, re-run apply-addresses.sh push, and every node is updated. Nothing
# else in the repo should hardcode an enclave address.
#
# WHY /etc/hosts AND DNS, in that order:
#   nsswitch on every node reads "hosts: files dns". /etc/hosts is therefore the PRIMARY
#   resolver and MAAS DNS is the FALLBACK - not the other way round. That is deliberate:
#   svc-mgmt-01 is a single VM on a single host, and apt, containerd and pro attach must not
#   stop working because it is rebooting.
#
# WHY .internal AND NOT .local:
#   systemd-resolved routes any multi-label name ending in .local to MulticastDNS, so it
#   never reaches a unicast DNS server. A .local name would work via /etc/hosts and then
#   silently fail the moment you relied on DNS. ICANN reserved .internal in 2024 for private
#   use; it can never resolve publicly and resolved does not special-case it.
# =========================================================================================

ENCLAVE_DOMAIN='enclave.internal'

# --- bare metal ----------------------------------------------------------------------------
# 10.2.20.155-158. Assigned 2026-09-01 on 10.0.20.x, renumbered to 10.2.20.x 2026-09-03
# when the lab moved behind its own router - see docs/runbook.md 3.1.
HOST_1='10.2.20.155'
HOST_2='10.2.20.156'
HOST_3='10.2.20.157'
HOST_4='10.2.20.158'

# --- service VMs, on host-4 ----------------------------------------------------------------
# svc-repo-01 and svc-harbor-01 are the expensive ones: their addresses are referenced by
# airgapped-contracts.yaml, by every client's apt sources, and by containerd's registry
# config. Renumbering them means regenerating the contracts config - see apply-addresses.sh,
# which refuses to stay quiet about it.
SVC_MGMT_01='10.2.20.161'
SVC_REPO_01='10.2.20.162'
SVC_HARBOR_01='10.2.20.163'

# --- Kubernetes ----------------------------------------------------------------------------
K8S_API_VIP='10.2.20.170'          # keepalived VRRP - Canonical does not provide an API VIP

# Service LoadBalancer pool. MUST be on the node subnet: the built-in load-balancer announces
# by ARP in L2 mode, which only works on the local segment. Not a single address, so it is
# recorded as a range rather than a variable the scripts consume.
#   k8s set load-balancer.cidrs="10.2.20.200-10.2.20.250"
K8S_LB_POOL_START='10.2.20.200'
K8S_LB_POOL_END='10.2.20.250'
K8S_CP_01='10.2.20.171'
K8S_CP_02='10.2.20.172'
K8S_CP_03='10.2.20.173'
K8S_WK_01='10.2.20.181'
K8S_WK_02='10.2.20.182'
K8S_WK_03='10.2.20.183'
K8S_WK_04='10.2.20.184'

# --- online-side, DELIBERATELY NOT in the enclave hosts file --------------------------------
# stage-01 and build-01 share the subnet but are outside the ATO boundary. Nothing in the
# enclave may depend on them at run time, so they are not published as names - if a node ever
# resolves "stage-01" that is a finding, not a convenience. Recorded here for the build phase
# only, where host-4 reaches the mirror by bare IP.
# --- Time -------------------------------------------------------------------------------
# The enclave's time source. It MUST be a physical machine: the service VMs run under KVM on
# host-4 and take their clock from it through kvm-clock, so a VM serving time to the network
# would be serving its own hypervisor's clock back to the hypervisor. host-4 is already the
# de facto master by that mechanism - naming it here makes it deliberate.
#
# Change this to host-1 once the production hosts exist, and to the GPS/PTP appliance's
# address if one is procured.
TIME_MASTER='10.2.20.158'
TIME_MASTER_NAME='host-4'
# Who may ask this machine for the time. The enclave subnet, and nothing else.
TIME_ALLOW='10.2.20.0/24'

STAGE_01='10.2.10.160'      # not published
BUILD_01='10.2.10.124'      # not published
