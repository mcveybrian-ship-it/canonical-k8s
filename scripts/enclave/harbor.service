# Harbor does not survive a reboot on its own.
#
# Its containers log through a syslog driver pointing at the harbor-log container
# (tcp://localhost:1514). At boot Docker starts every container with restart:always at once,
# harbor-log is not listening yet, and the other nine die instantly with:
#
#   failed to initialize logging driver: dial tcp [::1]:1514: connect: connection refused
#
# restart:always does NOT recover them, because the failure is at container CREATION rather
# than at runtime - Docker never gets far enough for a restart policy to apply. Observed on
# svc-harbor-01 after the FIPS reboot on 2026-09-08; nothing to do with FIPS, it happens on
# any reboot.
#
# `docker compose up -d` fixes it because compose honours depends_on and brings harbor-log up
# first. This unit simply does that, once, after Docker is ready.
#
#   sudo install -m 0644 harbor.service /etc/systemd/system/harbor.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now harbor.service
#
# The compose directory is hard-coded because there is exactly one Harbor and a systemd unit
# is not a good place for indirection. If Harbor moves, change it here and reinstall.

[Unit]
Description=Harbor container registry (docker compose)
Documentation=https://goharbor.io/docs/
# Requires, not Wants: without Docker there is nothing to start and failing loudly is right.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/harbor-src/harbor

# `up -d` rather than `start`: start fails on a container that was never created, and after a
# failed boot nine of them are in exactly that state.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

# Loading images and starting ten containers on a cold boot takes longer than the 90s default,
# and a timeout here leaves Harbor half-started with systemd reporting failure.
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
