# =========================================================================================
# pg-baseline.env - the ORG-DEFINED values of the Crunchy Data Postgres 16 STIG (V1R3) for this
# site's PostgreSQL cluster (backlog 6a.10). About 20 of the STIG's 111 rules say "compare against
# what the organization documented"; THIS FILE IS THAT DOCUMENTATION, and pg-stig.sh judges
# against it. A rule whose value is missing here is not_reviewed - never a pass.
#
# Decided 2026-09-30 / 2026-10-01 by the acting AO (B-06a slice 6). Tailorable: a new site changes
# the values, not the checker. It names NO application role or database - those are described by
# what they may do ("application" = any role or database that is not the platform's or the
# vendor's), so this file stays safe in a public repository.
#
# Read by scripts/enclave/pg-stig.sh. Plain KEY='value' lines, no shell expansion.
# =========================================================================================

# ---- roles ---------------------------------------------------------------------------------
# The platform's own roles, by name. Every other role (bar pg_* and the vendor's azure_*) is an
# application role and is masked in the evidence.
PGB_PLATFORM_ROLES='postgres replicator rewinder pgmonitor'
# V-261862 / V-261888 / V-261924 / V-261878: the ONLY superusers.
PGB_SUPERUSERS='postgres'
# V-261898: roles allowed CREATEROLE, CREATEDB or BYPASSRLS besides the superusers. None.
PGB_ADMIN_ATTR_ROLES=''

# ---- connections (V-261857) -----------------------------------------------------------------
PGB_MAX_CONNECTIONS='100'
# role=limit. NOLOGIN covers every role that cannot log in (0 says so). postgres's 10 is
# DOCUMENTED, NOT ENFORCED: PostgreSQL exempts superusers from role limits; its real bound is
# superuser_reserved_connections (3) inside max_connections. An application LOGIN role needs its
# own line here before it is granted LOGIN (B-07).
PGB_CONN_LIMITS='postgres=10 replicator=10 rewinder=10 pgmonitor=3 NOLOGIN=0'

# ---- network (V-261889, V-261926) ------------------------------------------------------------
PGB_PORT='5432'
# 'node' = the node's own enclave address (enclave-addresses.env) and nothing else.
PGB_LISTEN='node'

# ---- software (V-261886, V-261887, V-261888, V-261883, V-261935, V-261936, V-283674) ----------
# Extensions approved in any database: what the application declares. PostGIS (3 extensions)
# stays approved while backlog 3.49 asks whether the application needs it.
PGB_EXTENSIONS='plpgsql fuzzystrmatch uuid-ossp postgis postgis_topology postgis_tiger_geocoder'
# Packages approved on a pg node - the PostgreSQL-related ones, as installed 2026-10-01.
PGB_PACKAGES='postgresql-16 postgresql-client-16 postgresql-common postgresql-client-common postgresql-16-pgaudit postgresql-16-postgis-3 postgresql-16-postgis-3-scripts prometheus-postgres-exporter patroni pgbackrest'
# The PostgreSQL major version; any other installed is a finding (V-261935).
PGB_MAJOR='16'
# 'mirror' = "the latest version" means the newest postgresql-16 the enclave mirror offers, under
# the patching decision of 2026-09-23 (HANDOFF §3). Ubuntu ships PostgreSQL 16 in its main archive.
PGB_VERSION_SOURCE='mirror'

# ---- objects (V-261884, V-261914, V-261923, V-261924) -----------------------------------------
# Who may own objects. system = the postgres and template databases; application = the others.
# 'application' means any application role.
PGB_OWNERS_SYSTEM='postgres'
PGB_OWNERS_APPLICATION='postgres application'
# PUBLIC may CREATE in no schema and no database, and may write to no table.
PGB_PUBLIC_CREATE='none'
PGB_PUBLIC_TABLE_WRITE='none'

# ---- audit content (V-261872) -----------------------------------------------------------------
# Additional, organization-defined audit information beyond the log_line_prefix fields and
# pgaudit's statement text: none.
PGB_AUDIT_EXTRA='none'

# ---- certificates (V-261929) - OPEN, with this justification (acting AO, 2026-10-01) -----------
PGB_DOD_PKI='no'
PGB_DOD_PKI_JUSTIFICATION='The enclave is a closed, air-gapped network with no path to DoD PKI: no DoD-issued server certificates, and no CRL or OCSP service reachable inside the boundary. PostgreSQL and Patroni use the enclave own root CA (scripts/enclave/ca.sh; key custody, backlog 3.7); every certificate is issued and revoked inside the boundary, and peers verify against that root only. Left OPEN with this justification by the acting AO on 2026-10-01; revisit if DoD PKI or a DoD-approved PKI becomes reachable from the enclave (CAC/PIV, backlog 6a.23).'
