# =========================================================================================
# vm-specs.env - CPU / RAM / disk for each enclave VM.  Sizes from runbook section 1.5.
#
# Format:  VM_<NAME>='vcpus:ram_mb:disk_gb[:data_gb]'
#
# The 4th field is OPTIONAL and adds a SECOND disk on a different physical device, which is
# the only reason to want one - it needs VM_POOL_DATA set and 03-compose-vm.sh refuses rather
# than quietly landing it on the OS device. Only pg-01..03 use it. Every three-field spec
# behaves exactly as it did before 2026-09-16.
#
# Disks are SPARSE qcow2, so disk_gb is a ceiling rather than an allocation - svc-repo-01
# gets its 1 TB on paper and consumes what it actually holds (~325 GB today). That is what
# lets 1.7 TB of nominal VM disk live on a 1.9 TB vg-data with room to snapshot.
# =========================================================================================

# --- service VMs, host-4 -------------------------------------------------------------------
VM_SVC_MGMT_01='4:8192:100'         # MAAS region+rack, Pro air-gapped contract server
VM_SVC_REPO_01='4:16384:1024'       # apt mirror over nginx, Landscape, Enterprise Store
VM_SVC_HARBOR_01='8:16384:500'      # Harbor + its Postgres + Trivy. 500 GB is a GUESS - Q6

# svc-obs-01 - observability. SUBSUMES the machine the AO thread calls "svc-log-01": audit-log
# offload AND metrics on one VM, because they need the same disk, the same retention answer and
# the same hardening pass. Runbook 10a.
#
# 250 GB is MEASURED, not a guess. audit-volume.sh sampled hourly for 55 hours: 2.44 MB/day on
# svc-harbor-01, 1.71 MB/day on svc-repo-01. Twelve machines is ~30 MB/day, ~11 GB a year of
# audit. Prometheus is the bigger consumer at an estimated 150-200 MB/day, ~73 GB a year. 250 GB
# holds a year of both with headroom, and host-4 has 1.4 TB free.
#
# 8 GB RAM: Prometheus at this series count wants 2-4 GB, Grafana ~0.5 GB, rsyslog little.
VM_SVC_OBS_01='4:8192:250'

# --- PostgreSQL HA guests, one per physical host - runbook 9a ------------------------------
# THE DATA DISK IS LOCAL qcow2, NOT CEPH, AND THAT IS THE DESIGN. Ceph is the CLUSTER's
# storage, served to pods by ceph-csi. Postgres replication onto local qcow2 has predictable
# fsync semantics; on RBD there would be two consensus systems in the write path that can
# disagree during a partition - exactly when acknowledged writes are lost.
#
# WHY qcow2 AND NOT A RAW LV, WHICH WOULD BE FASTER: vm-backup.sh backs up qcow2 disks ONLY -
# domain_disks() tests the driver type - and reports the rest as skipped. A raw data disk means
# the OS disk is backed up and THE DATABASE IS NOT. qcow2 keeps it in the chain that is already
# built and verified, and Postgres is crash-safe, so a crash-consistent restore comes up by
# replaying its own WAL. Revisit only once WAL archiving is built AND tested.
#
# THE 1 TB M.2 ON HOSTS 1-3 IS SPLIT IN HALF - decided 2026-09-16:
#   p1 ~500 GB -> LUKS -> vg-pgdata -> this data disk   (the HOST owns the crypto)
#   p2 ~500 GB -> raw, unmatched, untouched -> k8s-wk-0N's Ceph OSD  (CEPH owns the crypto)
# Two partitions, NOT two LVs in one container: a host LUKS with Ceph --dmcrypt on top
# encrypts every OSD write TWICE, on the host with 2 of 8 threads uncommitted.
#
# THE PRICE, so nobody rediscovers it: Ceph goes from 4 x 1 TB to 4 x 500 GB - ~666 GB usable
# at replica-3, ~400 GB working under the 60% rule, down from ~800 GB. k8s-wk-04's OSD MUST be
# trimmed to 500 GB to match or placement skews (section 1.x); the extra was largely unusable
# anyway, since replica-3 across four nodes is gated by the three smallest OSDs. The ~500 GB
# that frees on host-4's 1 TB M.2 is the best candidate for the WAL archive - a dedicated
# device, off the database hosts, and not mixed into the apt mirror.
#
# 8 GB and 2 vCPU are the CEILING of the test hardware, NOT a production sizing: section 1.x
# already commits 22 of 32 GB and 6 of 8 threads on hosts 1-3, so this fills them. Production
# is unsized deliberately - "how many databases, one app's state or a shared service" is the
# SAME uncaptured requirement that blocks the Ceph OSD size and therefore the largest line in
# the BOM. Production additionally needs a separate DEVICE per pg guest, not just a partition.
VM_PG_01='2:8192:60:400'
VM_PG_02='2:8192:60:400'
VM_PG_03='2:8192:60:400'

# Where a data disk goes. MUST be a different physical device from VM_POOL - a data disk on
# the OS device is not a data disk, and 03-compose-vm.sh refuses rather than assume.
VM_POOL_DATA='/var/lib/libvirt/images-data'

# --- Kubernetes ----------------------------------------------------------------------------
# Workers each get a dedicated raw NVMe for their Ceph OSD; that device is NOT this disk.
VM_K8S_CP_01='4:16384:100'
VM_K8S_CP_02='4:16384:100'
VM_K8S_CP_03='4:16384:100'
VM_K8S_WK_01='8:32768:100'
VM_K8S_WK_02='8:32768:100'
VM_K8S_WK_03='8:32768:100'
VM_K8S_WK_04='8:32768:100'

# --- defaults for the composer -------------------------------------------------------------
VM_OSVARIANT='ubuntu24.04'

# Firmware: 'uefi' or 'bios'.
#
# UEFI by default, for two reasons found the hard way on svc-mgmt-01 (2026-09-03). Ubuntu's
# cloud images are primarily tested against UEFI; and more usefully, SeaBIOS writes only to
# VGA, so with --graphics none a "no bootable device" is completely invisible - the VM burns
# 2 seconds of CPU and sits there with nothing on the serial console. OVMF writes to serial,
# so a firmware-level failure is visible instead of silent.
VM_FIRMWARE='uefi'

# Secure Boot. OFF, and this is a deliberate decision with a date on it.
#
# 'virt-install --boot uefi' silently selects the Microsoft-keys-enrolled firmware
# (OVMF_CODE_4M.ms.fd, secure='yes', enrolled-keys='yes'). On 2026-09-03 svc-mgmt-01 booted
# under it as far as GRUB and then stopped with:
#
#     error: prohibited by secure boot policy.
#
# The VM reached a login prompt but cloud-init never ran at all, so it came up as stock
# 'ubuntu' with no address - a silent half-boot rather than a clean failure.
#
# Turning it off unblocks the build. It is NOT the final answer: Secure Boot is a STIG
# expectation and should be revisited during step 05 hardening, once there is time to work
# out which component the policy is actually rejecting. Tracked in docs/open-questions.md.
VM_SECURE_BOOT='false'
VM_BRIDGE='br0'
VM_POOL='/var/lib/libvirt/images'

# Base image, on the host doing the composing. The Minimal cloud image, not the server ISO:
# it needs no interactive installer and no autoinstall, so composing a VM is one command that
# either works or does not. The diagnostic package set is installed explicitly by cloud-init,
# which also makes it auditable - see VM_EXTRA_PACKAGES.
VM_BASE_IMAGE='/var/lib/libvirt/images/base/ubuntu-24.04-minimal-cloudimg-amd64.img'

# Where the VM installs packages from. stage-01 during the build; svc-repo-01 once it exists.
VM_MIRROR_URL='https://svc-repo-01.enclave.internal/archive.ubuntu.com/ubuntu/'
VM_MIRROR_SUITES='noble noble-updates noble-security'
VM_MIRROR_COMPONENTS='main universe'

# Installed on every VM. The runbook called for "standard server" on the service VMs; naming
# the packages gets the same diagnostic ability with an auditable list instead of whatever an
# ISO happened to ship.
# nano added 2026-09-08: the composed VMs are deliberately slim and ship vim only.
# Editing a config on one of these at 18:00 should not require knowing vi. It is 700 kB.
#
# rsyslog added 2026-09-10, and it is NOT a convenience - it is a STIG prerequisite.
# file_groupowner_var_log requires /var/log to be group-owned by `syslog`, and that GROUP DOES
# NOT EXIST on the Minimal image: it arrives with rsyslog, whose postinst runs
# `chgrp syslog /var/log; chmod g+w /var/log`. Without it the rule cannot pass without faking
# a group, which is hollow and visible to an assessor.
#
# Installing it at BUILD time rather than during hardening matters for two reasons: the next
# machine starts compliant instead of needing a post-hoc fix, and the rules it pulls into
# scope - rsyslog_remote_access_monitoring, which needs a `daemon.*` selector - are then
# present in the machine's FIRST baseline audit rather than appearing between two audits and
# looking like a regression. runbook §6.3c.
# libxml2-utils: stig-tailor.sh generate checks the tailoring XML for well-formedness with
# xmllint and SKIPS that check when it is absent - which it has been on every machine built so
# far, so the check has never once run. A generated 1500-line XML that nothing validates is a
# file you find out about from `usg audit` failing strangely.
VM_EXTRA_PACKAGES='openssh-server ca-certificates curl vim nano less bash-completion lsof strace tcpdump sysstat htop dnsutils rsync gnupg tmux ncurses-term rsyslog libxml2-utils'

VM_USER='encadmin'

# =========================================================================================
# POWER ORDER - read by vm-power.sh
#
# THE ORDER THE GUESTS ARE SHUT DOWN IN, first to last. Not a detail: on 2026-09-17 host-4
# rebooted with all four guests running and `libvirt-guests` logged
# "Can't connect to default. Skipping." - libvirtd was already gone when it ran, so the unit
# whose job this is did nothing and reported success.
#
# The guests DID close cleanly that night - Harbor's Postgres logged "database system was shut
# down at 00:24:44 UTC", four minutes before libvirt-guests ran, and all ten containers came
# back healthy. Nothing was damaged. The problem is that NOTHING IN THAT PATH IS ACCOUNTABLE:
# something stopped them gracefully and we cannot say what. It worked and it is not repeatable
# knowledge, which is exactly why the order below belongs in a script.
#
#   svc-obs-01     FIRST  - it scrapes the other four and runs 34 alert rules. Stopping it
#                           first keeps a planned outage out of Prometheus as a fake incident.
#   svc-harbor-01  next   - containerised Postgres under docker-compose. harbor.service has
#                           to stop 11 containers and close a database. The slowest stop;
#                           give it the most room.
#   svc-mgmt-01    next   - MAAS's own Postgres 16 plus the Pro contract server.
#   svc-repo-01    LAST   - nginx over static files, nothing to lose, and it is what
#                           everything else installs from.
#
# Startup is this list REVERSED, so the mirror is up before anything that might want it.
VM_POWER_ORDER='svc-obs-01 svc-harbor-01 svc-mgmt-01 svc-repo-01'

# Seconds to wait for ONE guest to reach 'shut off' before giving up on it. virsh shutdown is
# ASYNCHRONOUS - it sends ACPI and returns immediately - so this timeout is the only thing
# standing between a planned reboot and a half-flushed database. Harbor is the one that needs
# it; the others are done in well under a minute.
VM_POWER_TIMEOUT='300'

# Seconds to wait for a guest to answer on the network after starting it. A domain reports
# 'running' the instant qemu execs, which is long before the guest is usable.
VM_POWER_BOOT_TIMEOUT='180'

# =========================================================================================
# BACKUP DESTINATION - read by vm-backup.sh
#
# NOT A PATH IN A SCRIPT. This is an external drive on the bench today and a customer-
# provided mount, LUN or NFS export in production, and those are the same procedure with a
# different value here. Override per-run with --dest, or with VM_BACKUP_DEST in the
# environment; this is only the default.
#
# IT MUST BE A MOUNTPOINT. vm-backup.sh refuses a destination that is not one, because a
# path that LOOKS like a mounted drive and is not writes the backup onto the root disk -
# quietly, at full speed, until the machine falls over. The failure is indistinguishable
# from success until the disk fills.
BACKUP_DEST='/mnt/vmbackup'

# How many FULL backup chains to keep. Each chain is one full plus its incrementals, so 2
# means you can always restore while the newest chain is being written.
BACKUP_KEEP_CHAINS='2'

# WHEN THE BACKUP RUNS - IN THE OPERATOR'S TIMEZONE, NOT THE MACHINE'S.
#
# Every enclave machine runs UTC on purpose: audit records and documentation timestamps are
# UTC and labelled as such. But "2am" means 2am where the person carrying the pager lives,
# and that is US Central. A bare 02:00 in the timer put the job at 21:00 Central - the middle
# of the working evening, while the guests were busiest.
#
# Do NOT convert it by hand. 02:00 Central is 07:00 UTC under CDT and 08:00 UTC under CST, so
# a hardcoded offset moves the job by an hour every March and November and nobody notices.
# systemd 252+ takes the zone inside the calendar spec and handles the change itself;
# `vm-backup.sh schedule` builds the spec and refuses to install one systemd cannot parse.
BACKUP_TZ='America/Chicago'

# The weekly DEEP verify - the run that re-reads every byte and is the only thing that can
# catch decay on the volume. Interpreted in BACKUP_TZ. Kept well clear of the nightly run:
# both read the same USB device and overlapping them halves the throughput of each.
BACKUP_VERIFY_ONCALENDAR='Sun *-*-* 04:00'

# The encrypted volume behind BACKUP_DEST, for `vm-backup.sh reattach` after a reboot.
#
# ADDRESSED BY LUKS UUID, NOT BY /dev/sdX AND NOT BY THE USB by-id STRING. Unloading and
# reloading the USB modules re-enumerates the bus - this machine has already had a drive move
# from sdb to sda once - and the by-id string changes if the disk is ever put in a different
# enclosure. The LUKS UUID is written inside the header and follows the data.
#   find it with:  sudo blkid -s UUID -o value <partition>
BACKUP_LUKS_UUID='72c5e0c5-8c87-465a-a729-59cd12d69d13'
BACKUP_LUKS_NAME='vmbackup'

# Keyfile so a scheduled backup can unlock the volume with no human present. It lives on
# host-4's OWN encrypted root, so it is only readable once that machine is already unlocked
# and running - a stolen backup drive does not come with its key.
BACKUP_KEYFILE='/etc/enclave/vmbackup.key'
