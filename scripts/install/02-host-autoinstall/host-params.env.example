# Copy to host-params.env and fill in. That file is gitignored; this one is not.
# Shared across all three hosts. Per-host values (-H hostname, -a address) are
# passed on the command line.

# Network interface match. 'en*' = any wired NIC, correct for single-NIC hosts.
# Narrow it on multi-NIC machines - it applies to every interface it matches.
NIC_MATCH='en*'

PREFIX=24
GATEWAY=10.0.20.1
DNS=10.0.20.1

# mkpasswd --method=SHA-512 --rounds=4096
PASSWORD_HASH='$6$REPLACE'

# --- SSH access ------------------------------------------------------------------------------
# allow-pw: password SSH.
#   true  during the build - you cannot finish a host you cannot reach
#   false at step 03 hardening - the STIG requires key-only
ALLOW_PW=false

# Authorized keys, one per line, numbered from 1. Every SSH_KEY_n present is installed on
# every host. Numbering lets you revoke one workstation without touching the others.
#
# Generate with:  ssh-keygen -t rsa -b 4096 -C "you@where"
# RSA or ECDSA only - FIPS mode refuses Ed25519.
#
# NOTE: WSL and Windows have SEPARATE ~/.ssh directories. A key made in WSL is not visible
# to PowerShell's ssh.exe or to SecureCRT. Add one key per environment you connect from.
SSH_KEY_1='ssh-rsa AAAA... you@windows'
#SSH_KEY_2='ssh-rsa AAAA... you@wsl'
#SSH_KEY_3='ssh-rsa AAAA... ops@jumpbox'

# --- Console ----------------------------------------------------------------------------------
# Where do INTERACTIVE prompts go - the LUKS passphrase, single-user mode, emergency shell?
# Kernel messages go to every console listed; /dev/console is the LAST one on the cmdline.
#
#   false  tty0 last  -> prompts on an attached monitor. Correct for a lab box or anything
#                        you stand in front of. Serial still receives all kernel output.
#   true   ttyS0 last -> prompts on serial. Correct ONLY for a racked host with working
#                        BMC serial-over-LAN, where nobody will ever attach a monitor.
#
# Set true by mistake and a LUKS host looks hung at boot: boot messages appear, then nothing,
# because it is waiting for a passphrase on a port you are not connected to.
SERIAL_CONSOLE=false

# --- Disk selection --------------------------------------------------------------------------
# Matched on id_path, which encodes the physical bus, because serials differ per machine and
# 'size' is unsafe - subiquity does NOT exclude removable media from size matching, and on the
# pathfinder it chose the 120 MB CIDATA seed stick as the OS disk and destroyed it.
#
# THESE DEFAULTS ARE NOT UNIVERSAL. They assume a SATA OS disk plus an NVMe data disk. On an
# all-NVMe host, '*-ata-*' matches nothing and '*-nvme-*' matches every disk. CONFIRM ON THE
# REAL HARDWARE BEFORE WRITING A SEED:
#
#     ls -l /dev/disk/by-path/ | grep -v part
#
# Typical results:
#     pci-0000:05:00.1-ata-2                   -> sda      SATA (incl. M.2 SATA)
#     pci-0000:03:00.0-nvme-1                  -> nvme0n1  NVMe slot 1
#     pci-0000:82:00.0-nvme-1                  -> nvme1n1  NVMe on a PCIe card
#     pci-...-usb-...                          -> sdc      USB  <- must never match
#
# On an all-NVMe host, disambiguate by PCI address rather than by bus type, e.g.
#     OS_DISK_MATCH='pci-0000:03:00.0-nvme-*'
#     DATA_DISK_MATCH='pci-0000:82:00.0-nvme-*'
# Neither pattern may match a '*-usb-*' path. Both must resolve to exactly one disk.
OS_DISK_MATCH='*-ata-*'
DATA_DISK_MATCH='*-nvme-*'

# --- Disk encryption -------------------------------------------------------------------------
# IL5 requires data-at-rest encryption. true puts a LUKS layer under BOTH volume groups.
# false leaves the disks in plaintext - only appropriate for a throwaway lab box.
ENCRYPT_DISKS=true

# LUKS passphrase. Ignored when ENCRYPT_DISKS=false.
#
# WARNING: this is written in PLAINTEXT into user-data on the seed stick. The stick is a
# credential - control it and wipe it after the build.
LUKS_PASSPHRASE='REPLACE-ME-luks-passphrase'

# How the OS volume is unlocked at boot. Ignored when ENCRYPT_DISKS=false.
#
#   passphrase   Somebody types it at the console on EVERY boot. Measured on host-4
#                2026-09-16: the machine sat unreachable until the passphrase was entered and
#                all four guests went with it, so the whole enclave was down for the duration.
#                Two factors - the disk AND a human. Defeats both a stolen drive and a stolen
#                chassis.
#
#   tpm2         The TPM releases the key if the boot chain measures as expected, and the
#                passphrase slot is KEPT as a fallback. Unattended reboot works. One factor -
#                the disk AND this specific motherboard. Defeats a stolen drive; does NOT
#                defeat a stolen chassis, which boots itself.
#
# NO STIG CONTROL CARES WHICH YOU PICK. Verified 2026-09-16 against the full DISA V1R6
# checklist: zero of 194 controls mention TPM, and V-270747 checks only that every persistent
# partition has a /etc/crypttab entry - not how the key is supplied. This is a risk decision
# for the AO, not a compliance one. Open question Q20 has the trade-off written out.
#
# THIS PARAMETER ONLY RECORDS THE CHOICE. The enrolment CANNOT happen in the installer:
# sealing binds to the boot chain's PCR measurements, and curtin runs in the installer's boot
# state, not the installed system's. Sealing there would bind to the wrong measurement. The
# value is written to /etc/enclave-build-info and acted on after first boot by:
#
#     sudo ./scripts/enclave/stig-tailor.sh luksenroll
#
# PCR POLICY IS FIXED AT 7 (secure boot state) and that is deliberate. PCR 11 covers the
# kernel and initrd, which would be stronger - but it CHANGES ON EVERY KERNEL UPDATE, and this
# enclave takes FIPS kernel updates. Sealing to 11 would mean the host stops unlocking
# unpredictably, after a patch, at 02:00 - worse than always needing a human.
LUKS_UNLOCK=passphrase

# --- Identity and sizing ----------------------------------------------------------------------
USERNAME=encadmin

# Logical volume sizes on vg0. The remainder of the volume group is left free for growth.
LV_ROOT=40G
LV_HOME=10G
LV_VAR=30G
LV_VARLOG=20G
LV_VARLOGAUDIT=20G
LV_TMP=10G
