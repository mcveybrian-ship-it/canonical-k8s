# ---------------------------------------------------------------------------------------
# Step 03 - host services parameters.   Copy to services-params.env and edit.
#
#     cp services-params.env.example services-params.env && chmod 600 services-params.env
#
# Nothing in 03-host-services.sh is hardcoded. Every address, name and size is here.
# ---------------------------------------------------------------------------------------

# ---- The apt mirror this host installs from -------------------------------------------
# Outside the gap this is stage-01. Inside the gap it becomes svc-repo-01 and NOTHING ELSE
# in this file changes - that is the point of it being a parameter.
#
# NOTE the path segment: the mirror tree is served as /archive.ubuntu.com/ubuntu/, so the
# string "archive.ubuntu.com" appears in the URL without being a route to the internet.
MIRROR_URL='http://10.0.20.160/archive.ubuntu.com/ubuntu/'

# What was actually mirrored. apt-mirror pulled main+universe, amd64, security folded into
# the archive tree. Listing restricted or multiverse here makes apt-get update FAIL.
MIRROR_SUITES='noble noble-updates noble-security'
MIRROR_COMPONENTS='main universe'
MIRROR_KEYRING='/usr/share/keyrings/ubuntu-archive-keyring.gpg'

# ---- Bridge ---------------------------------------------------------------------------
# VMs must sit on the enclave LAN, not behind libvirt's 192.168.122.0/24 NAT: svc-repo-01
# has to serve apt to host-1..3, and svc-mgmt-01 has to reach every host's BMC.
BRIDGE_NAME='br0'
BRIDGE_NIC='enp42s0'          # the NIC that currently carries BRIDGE_ADDRESS
BRIDGE_ADDRESS='10.0.20.158/24'
BRIDGE_GATEWAY=''             # EMPTY = no default route. Correct for an air-gapped host.
BRIDGE_DNS=''                 # EMPTY = omit nameservers entirely.

# ---- Data volume group ----------------------------------------------------------------
# vg-data is created by the step-02 autoinstall on top of crypt-data, with no LVs - the
# sizes depend on what services land here, which is this step's job to decide.
DATA_VG='vg-data'

# name:size:mountpoint, space separated. Sized against a 1.9T crypt-data.
# Deliberately UNDER-allocated: an LV extends online, shrinking one does not.
DATA_LVS='libvirt:700G:/var/lib/libvirt/images repo:500G:/srv/repo harbor:200G:/srv/harbor'

DATA_FSTYPE='ext4'
# Mount options. nodev/nosuid on the repo and harbor volumes are STIG-relevant; the libvirt
# image store cannot take nodev.
DATA_MOUNTOPTS_DEFAULT='defaults,nodev,nosuid'
DATA_MOUNTOPTS_LIBVIRT='defaults'

# ---- libvirt --------------------------------------------------------------------------
# The NAT network is switched off, not deleted - deleting it makes a later change harder to
# reason about, and an inactive autostart=no network costs nothing.
DISABLE_DEFAULT_NAT='true'
POOL_NAME='images'
POOL_PATH='/var/lib/libvirt/images'
