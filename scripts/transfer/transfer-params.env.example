# transfer-params.env - parameters for the three media-transfer scripts.
#
# Copy to transfer-params.env and edit. That file is gitignored: it names hosts and
# paths, and on svc-repo-01 it is read by root.
#
#   cp transfer-params.env.example transfer-params.env
#
# Nothing in the scripts is hardcoded. If you find yourself editing a script to change
# a path, an address or a size, it belongs here instead.

# --- STAGE-01: where the mirror actually lives -----------------------------------------------
# The apt-mirror base path (holds mirror/, keys/, debs/). Set in /etc/apt/mirror.list.
MIRROR_BASE=/srv/apt-mirror

# The step 00 install media - ISOs and cloud images.
MEDIA_DIR=/home/encadmin/canonical-k8s/scripts/install/media

# Where build-bundle.sh assembles the SMALL extras. This is NOT a copy of the 317 GB
# mirror - see the header of build-transfer-bundle.sh for why.
STAGING_DIR=/srv/bundle-staging

# --- Hosts ------------------------------------------------------------------------------------
STAGE_HOST=10.0.20.160
STAGE_USER=encadmin

BUILD_HOST=10.0.20.124
BUILD_USER=encadmin

# SSH key build-01 uses to pull from STAGE-01, and STAGE-01 uses to reach build-01.
# RSA or ECDSA only - every enclave host refuses Ed25519 under FIPS.
SSH_KEY=/home/encadmin/.ssh/build01

# --- build-01: where the bundle is staged and where the SSD mounts ----------------------------
BUILD_STAGING=/srv/bundle

# Mount point of the transfer SSD. write-transfer-media.sh refuses to write anywhere
# that is not a mounted filesystem, so this must be mounted before it runs.
MEDIA_MOUNT=/mnt/transfer

# Filesystem label written when preparing the SSD. Mount by label, never by device
# name - /dev/sdX moves between machines and reboots.
MEDIA_LABEL=enclave-xfer

# --- svc-repo-01, inside the gap ---------------------------------------------------------------
# Where restore-mirror.sh puts the repository tree. nginx serves from $REPO_ROOT/mirror.
REPO_ROOT=/srv/repo

# Address clients use to reach this box. Rewritten into the apt sources and into
# airgapped-contracts.yaml's aptURL entries.
REPO_ADDRESS=svc-repo-01.enclave.local

# Port the air-gapped contracts server listens on.
CONTRACTS_PORT=8484

# --- Behaviour ---------------------------------------------------------------------------------
# rsync bandwidth cap in KB/s. 0 = unlimited. Set this if the transfer competes with
# anything else on the link.
RSYNC_BWLIMIT=0

# Suites actually mirrored. Used to verify a restore is complete rather than assuming.
# Format: <archive-path>:<suite> - matches the deb lines in mirror.list.
EXPECTED_SUITES="archive.ubuntu.com/ubuntu:noble
archive.ubuntu.com/ubuntu:noble-updates
archive.ubuntu.com/ubuntu:noble-security
esm.ubuntu.com/infra/ubuntu:noble-infra-security
esm.ubuntu.com/infra/ubuntu:noble-infra-updates
esm.ubuntu.com/apps/ubuntu:noble-apps-security
esm.ubuntu.com/apps/ubuntu:noble-apps-updates
esm.ubuntu.com/fips-updates/ubuntu:noble-updates
esm.ubuntu.com/usg/ubuntu:noble"
